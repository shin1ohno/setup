{
  "claudeMdExcludes": ["**/cookbooks/claude-code/files/CLAUDE.md"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run-ruby.sh\" guard-mitamae-dry-run.rb"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run-ruby.sh\" remind-cookbook-dry-run.rb"
          }
        ]
      }
    ]
  }
}
