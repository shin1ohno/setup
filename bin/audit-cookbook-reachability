#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Guardrail (Phase 0 of docs/refactoring/plan.md): fail when a cookbook under
# cookbooks/ is unreachable from any apply entry point via the include graph.
#
# Entry roots:  darwin.rb, linux.rb, test-cookbook.rb, pve/*.rb
# Graph edges:  include_role "X"            -> roles/X/default.rb
#               include_cookbook "X"        -> cookbooks/X/default.rb
#               include_platform_cookbook "X" -> cookbooks/X/{darwin,linux}.rb
#                                              (BOTH must exist — a half-split
#                                               cookbook fails the audit)
#               include_recipe "[../]cookbooks/X/..."  -> cookbook X
#               include_recipe "bare"       -> <same-dir>/bare.rb (intra-cookbook,
#                                              NOT a new cookbook node; e.g.
#                                              homebrew -> "environment")
#               lxc_entry(...)              -> include_role "lxc-core"
#                                              + include_cookbook "elastic-agent::linux"
#                                              (see cookbooks/functions/default.rb
#                                               #lxc_entry)
#
# A cookbook in ALLOWLIST is permitted to be unreachable (Phase 1 deletes the
# dead cookbooks and empties this list). Any OTHER unreachable cookbook fails CI.
#
# FAIL conditions:
#   1. a cookbook is unreachable and not allowlisted
#   2. include_platform_cookbook "X" with only one of the two per-OS recipes
#   3. a per-OS recipe (cookbooks/*/{darwin,linux}.rb) that no caller includes
#   4. a STALE INCLUDE — an include whose target recipe file does not exist
#
# Condition 4 exists because reachability is keyed on the cookbook NAME: an
# `include_cookbook "mcp"` left behind after mcp/default.rb became darwin.rb +
# linux.rb still marks the mcp cookbook reached, so conditions 1-3 all pass while
# every apply that walks that line dies on mitamae's "Cookbook mcp is not found
# at cookbooks/mcp/default.rb". Before this check, the first thing to notice was
# the CI dry-run (#817).
#
# Usage:  bin/audit-cookbook-reachability   # exit 1 on any FAIL condition
#
# This is a static approximation: variable / node-driven includes
# (e.g. test-cookbook.rb's `include_cookbook ENV["COOKBOOK"]`) cannot be
# resolved and contribute no edges. If a real cookbook is reachable only via
# such a dynamic include, add it to ALLOWLIST with a comment.

require "set"

REPO_ROOT = File.expand_path("..", __dir__)
Dir.chdir(REPO_ROOT)

# Cookbooks intentionally allowed to be unreachable. Empty as of Phase 1 (all
# dead/dormant cookbooks deleted in PR 1-1 + 1-2). Add an entry ONLY for a
# cookbook that is genuinely used but not include-reachable (e.g. a file-store
# read by path), with a justifying comment — file-store refs are already
# auto-detected below, so a manual entry should be rare.
ALLOWLIST = %w[].freeze

# lxc_entry(...) expands to these (functions/default.rb#lxc_entry).
LXC_ENTRY_ROLE      = "lxc-core"
LXC_ENTRY_COOKBOOK  = "elastic-agent"
LXC_ENTRY_TAIL      = "gate-report"

ENTRY_FILES = (["darwin.rb", "linux.rb", "test-cookbook.rb"] + Dir["pve/*.rb"]).select { |f| File.file?(f) }

# A cookbook is a directory under cookbooks/ with at least one top-level
# recipe (*.rb). Per-OS split cookbooks (stream B) ship {darwin,linux}.rb
# with NO default.rb — the old default.rb-based definition would silently
# drop them from the audit universe.
all_cookbooks = Dir["cookbooks/*"]
                .select { |d| File.directory?(d) && !Dir["#{d}/*.rb"].empty? }
                .map { |p| p.split("/")[1] }.to_set

reached_cookbooks = Set.new
visited_files     = Set.new
queue             = []
half_split        = []
missing_targets   = []

# `origin` is the "<file>: <include as written>" description of the edge being
# followed. When it is given and the target file does not exist, the edge is a
# STALE INCLUDE: mitamae raises "Cookbook X is not found at ..." at compile
# time, but nothing static caught it before this check existed — reached_cookbooks
# is keyed on the cookbook NAME, so an include pointing at a recipe file deleted
# by a per-OS split still marked its cookbook reachable and the audit passed.
# (Proven by #817, whose stale `include_cookbook "mcp"` cleared audit + lint and
# failed first in the CI dry-run.)
#
# origin is nil for edges whose target is guaranteed by construction — the entry
# files, which ENTRY_FILES already filtered through File.file?.
def enqueue(path, queue, visited_files, missing_targets = nil, origin = nil)
  return unless path
  # Normalize to a REPO_ROOT-relative path so BFS bookkeeping (and the per-OS
  # orphan check at the end) compares one canonical form regardless of how
  # the include was written (absolute expand_path vs relative join).
  path = path.sub("#{REPO_ROOT}/", "")
  unless File.file?(path)
    missing_targets << "#{origin} -> #{path} does not exist" if origin && missing_targets
    return
  end
  return if visited_files.include?(path)
  visited_files << path
  queue << path
end

ENTRY_FILES.each { |f| enqueue(f, queue, visited_files) }

until queue.empty?
  file = queue.shift
  dir  = File.dirname(file)
  # Skip the BODY of every method definition, not just the `def` line: a
  # helper like `def lxc_entry` (functions/default.rb) contains literal
  # include_role/include_cookbook calls that are NOT real top-level edges —
  # they fire only when the method is CALLED. Real lxc_entry() call sites are
  # picked up by the `lxc_entry\s*\(` branch below. Without this, every entry
  # recipe (all include functions/default.rb) force-marks lxc-core +
  # elastic-agent reachable even if no recipe actually calls lxc_entry.
  def_stack = []
  File.foreach(file) do |raw|
    indent = raw[/\A */].length
    if raw =~ /\A\s*def\b/
      def_stack.push(indent)
      next
    end
    if raw =~ /\A\s*end\b/ && !def_stack.empty? && indent == def_stack.last
      def_stack.pop
      next
    end
    next unless def_stack.empty? # inside a method body — not a real include
    next if raw =~ /\A\s*#/      # skip comment-only lines
    line = raw

    # Only STRING-LITERAL includes are resolvable statically. The one dynamic
    # include in the repo — test-cookbook.rb's `include_cookbook cookbook_name`
    # (COOKBOOK env var) — has no quote and never matches, so it is excluded
    # from the stale-target check for free rather than by name.
    line.scan(/\binclude_cookbook\s+"([^"]+)"/) do |m|
      cb = m[0].split("::").first
      reached_cookbooks << cb
      parts = m[0].split("::")
      parts << "default" if parts.length == 1
      enqueue(File.join("cookbooks", *parts) + ".rb", queue, visited_files,
              missing_targets, "#{file}: include_cookbook \"#{m[0]}\"")
    end

    line.scan(/\binclude_role\s+"([^"]+)"/) do |m|
      parts = m[0].split("::")
      parts << "default" if parts.length == 1
      enqueue(File.join("roles", *parts) + ".rb", queue, visited_files,
              missing_targets, "#{file}: include_role \"#{m[0]}\"")
    end

    # include_platform_cookbook "X" dispatches to cookbooks/X/<os>.rb at apply
    # time; statically, BOTH per-OS recipes must exist — one missing means a
    # half-split cookbook that raises on one platform's apply.
    line.scan(/\binclude_platform_cookbook\s+"([^"]+)"/) do |m|
      cb = m[0].split("::").first
      reached_cookbooks << cb
      %w[darwin linux].each do |os|
        f = File.join("cookbooks", cb, "#{os}.rb")
        if File.file?(f)
          enqueue(f, queue, visited_files)
        else
          half_split << "#{file}: include_platform_cookbook \"#{cb}\" but #{f} is missing"
        end
      end
    end

    line.scan(/\binclude_recipe\s+"([^"]+)"/) do |m|
      target = m[0]
      if target =~ %r{(?:\.\./)?cookbooks/([^/]+)/}
        reached_cookbooks << Regexp.last_match(1)
      end
      # Resolve to an actual file for transitive parsing.
      path =
        if target.start_with?("../")
          File.expand_path(target, dir)
        elsif target.include?("/")
          File.join(REPO_ROOT, target)
        else
          File.join(dir, target) # bare intra-cookbook recipe
        end
      path += ".rb" unless path.end_with?(".rb")
      enqueue(path, queue, visited_files,
              missing_targets, "#{file}: include_recipe \"#{target}\"")
    end

    if line =~ /\blxc_entry\s*\(/
      reached_cookbooks << LXC_ENTRY_COOKBOOK
      reached_cookbooks << LXC_ENTRY_TAIL
      # elastic-agent is a per-OS split cookbook; lxc_entry includes its LINUX
      # recipe statically (every LXC is linux). Enqueue the same file the helper
      # does, or elastic-agent/linux.rb reads as an orphan.
      # These three are real edges too: if lxc_entry's targets move or split,
      # every LXC apply breaks, so a missing one is reported like any other.
      enqueue(File.join("cookbooks", LXC_ENTRY_COOKBOOK, "linux.rb"), queue, visited_files,
              missing_targets, "#{file}: lxc_entry(...)")
      enqueue(File.join("cookbooks", LXC_ENTRY_TAIL, "default.rb"), queue, visited_files,
              missing_targets, "#{file}: lxc_entry(...)")
      enqueue(File.join("roles", LXC_ENTRY_ROLE, "default.rb"), queue, visited_files,
              missing_targets, "#{file}: lxc_entry(...)")
    end

    # File-store cookbooks: a recipe that reads cookbooks/<name>/files/... by
    # path (File.read / File.expand_path) keeps that cookbook alive without an
    # include_cookbook edge. e.g. pve/lxc-consent.rb reads
    # cookbooks/consent-app/files/ directly (consent-app is a static source
    # store, intentionally not include'd — see cookbooks/consent-app/default.rb).
    line.scan(%r{\bcookbooks/([a-z0-9_-]+)/files}) do |m|
      reached_cookbooks << m[0]
    end
    # Sibling-cookbook file-store ref from inside a cookbook: a recipe in
    # cookbooks/<a> reads cookbooks/<b>/files via a relative "../<b>/files"
    # path (File.dirname(__FILE__) is the cookbook dir). e.g. cookbooks/
    # lxc-consent reads ../consent-app/files. Only matches a sibling-cookbook
    # name, so it can mark a live cookbook reachable but never hides a dead one.
    line.scan(%r{\.\./([a-z0-9_-]+)/files}) do |m|
      reached_cookbooks << m[0]
    end
  end
end

unreachable      = (all_cookbooks - reached_cookbooks).sort
unexpected       = unreachable - ALLOWLIST
stale_allowlist  = ALLOWLIST.select { |c| reached_cookbooks.include?(c) }
missing_targets  = missing_targets.uniq.sort # one edge can be walked from several entries

# Per-OS recipes that no caller ever includes (e.g. zsh::darwin referenced but
# linux.rb orphaned after a partial migration). visited_files holds normalized
# repo-relative paths, so a plain set-difference is sound.
per_os_orphans = Dir["cookbooks/*/{darwin,linux}.rb"].reject { |p| visited_files.include?(p) }.sort

puts "cookbook reachability audit"
puts "  cookbooks total : #{all_cookbooks.size}"
puts "  reachable       : #{reached_cookbooks.size}"
puts "  unreachable     : #{unreachable.size} (#{unreachable.join(", ")})" unless unreachable.empty?
puts "  allowlisted     : #{ALLOWLIST.size}"

unless stale_allowlist.empty?
  warn ""
  warn "WARNING: allowlisted cookbooks that are actually reachable (remove from ALLOWLIST):"
  stale_allowlist.each { |c| warn "  - #{c}" }
end

unless missing_targets.empty?
  warn ""
  warn "FAIL: #{missing_targets.size} include(s) whose target recipe does not exist (stale include):"
  missing_targets.each { |msg| warn "  - #{msg}" }
  warn ""
  warn "mitamae raises \"... is not found at <path>\" on these at compile time."
  warn "A per-OS split is the usual cause: cookbooks/<name>/default.rb was replaced"
  warn "by darwin.rb + linux.rb, so callers need include_platform_cookbook \"<name>\""
  warn "(dual-OS caller) or the static \"<name>::linux\" / \"<name>::darwin\" form."
end

unless half_split.empty?
  warn ""
  warn "FAIL: #{half_split.size} half-split cookbook reference(s) — include_platform_cookbook needs BOTH per-OS recipes:"
  half_split.each { |msg| warn "  - #{msg}" }
end

unless per_os_orphans.empty?
  warn ""
  warn "FAIL: #{per_os_orphans.size} per-OS recipe(s) no caller includes (orphaned by a partial migration):"
  per_os_orphans.each { |p| warn "  - #{p}" }
end

if unexpected.empty? && half_split.empty? && per_os_orphans.empty? && missing_targets.empty?
  puts "OK: every cookbook is reachable or allowlisted."
  exit 0
else
  unless unexpected.empty?
    warn ""
    warn "FAIL: #{unexpected.size} cookbook(s) unreachable and NOT allowlisted:"
    unexpected.each { |c| warn "  - cookbooks/#{c}" }
    warn ""
    warn "Either wire it into an entry recipe / role, delete it, or add it to"
    warn "ALLOWLIST in bin/audit-cookbook-reachability with a justifying comment."
  end
  exit 1
end
