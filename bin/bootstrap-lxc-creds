#!/usr/bin/env bash
# bin/bootstrap-lxc-creds — seed the pve-bootstrap-ssm AWS profile on a
# fresh LXC by copying it from the PVE host's existing profile.
#
# Usage:
#   bin/bootstrap-lxc-creds <CT_ID>
#
# Environment overrides:
#   PVE_HOST     default 192.168.1.10
#   AWS_PROFILE  default pve-bootstrap-ssm
#   AWS_REGION   default ap-northeast-1
#
# Prerequisites:
#   - SSH access to the PVE host as root
#   - PVE host has the pve-bootstrap-ssm profile configured (~/.aws/credentials)
#
# Idempotent: re-running with the same CT_ID overwrites the file with the
# same content, which is safe. Use this after provisioning a fresh LXC
# (terraform / pct create) and before the first mitamae apply, so that
# auto-mitamae-target's SSM-gated block can fetch the orchestrator and
# break-glass public keys on the first run instead of the second.
#
# Single-profile mode (adds or replaces ONE named profile, leaves every other
# profile in /root/.aws/{credentials,config} untouched):
#
#   bin/bootstrap-lxc-creds --profile <NAME> [--stdin] <CT_ID>
#
#   --stdin   read the key pair from this script's stdin (two lines: access key
#             id, then secret access key; prompted without echo on a TTY)
#             instead of from the PVE host's own <NAME> profile. Use it for a
#             profile the PVE host does not (and should not) hold, e.g. the
#             CT 119-only es-memory-ct119-bootstrap principal (design spec
#             docs/design/claude-session-search.md §10):
#               aws ssm get-parameter ... | bin/bootstrap-lxc-creds \
#                 --profile es-memory-ct119-bootstrap --stdin 119
#
#   The key pair travels to the CT on ssh stdin only — never in an argv on the
#   operator host, the PVE host or the CT — and is never printed. The CT-side
#   rewrite runs under the same /var/lock/aws-creds-bootstrap.lock (exit 75
#   when held) and writes 0600 files through a temp file + rename. Afterwards
#   `aws sts get-caller-identity --profile <NAME>` is run on the CT and its
#   result (OK / not usable) is reported. The default mode below is unchanged.

set -euo pipefail

# The CT-side half of single-profile mode. Reads AKID and SAK from stdin, drops
# only the [<NAME>] / [profile <NAME>] sections and appends the new ones.
# PROFILE and REGION are prepended by the caller after validation.
read -r -d '' CT_ADD_PROFILE_SCRIPT <<'CTEOF' || true
set -euo pipefail
IFS= read -r AKID
IFS= read -r SAK
[[ "$AKID" =~ ^[A-Z0-9]{16,128}$ ]] || { echo "access key id has an unexpected shape" >&2; exit 65; }
[[ -n "$SAK" && "$SAK" != *[[:space:]]* ]] || { echo "secret access key is empty or has whitespace" >&2; exit 65; }
exec 9>/var/lock/aws-creds-bootstrap.lock
flock -n 9 || { echo "another bootstrap in progress" >&2; exit 75; }
mkdir -p /root/.aws && chmod 700 /root/.aws
umask 077
drop_section() { # <file> <exact header line>: the file without that section
  [ -f "$1" ] || return 0
  awk -v h="$2" '/^[[:space:]]*\[/ { skip = ($0 == h) } !skip' "$1"
}
{
  drop_section /root/.aws/credentials "[${PROFILE}]"
  printf '[%s]\naws_access_key_id = %s\naws_secret_access_key = %s\n' "$PROFILE" "$AKID" "$SAK"
} > /root/.aws/credentials.new
{
  drop_section /root/.aws/config "[profile ${PROFILE}]"
  printf '[profile %s]\nregion = %s\n' "$PROFILE" "$REGION"
} > /root/.aws/config.new
chmod 600 /root/.aws/credentials.new /root/.aws/config.new
mv /root/.aws/credentials.new /root/.aws/credentials
mv /root/.aws/config.new /root/.aws/config
CTEOF

add_profile_mode() {
  local name="${1:?Usage: bootstrap-lxc-creds --profile <NAME> [--stdin] <CT_ID>}"
  shift
  local from_stdin=0
  if [[ "${1:-}" == "--stdin" ]]; then
    from_stdin=1
    shift
  fi
  local ct_id="${1:?Usage: bootstrap-lxc-creds --profile <NAME> [--stdin] <CT_ID>}"
  local pve_host="${PVE_HOST:-192.168.1.10}"
  local region="${AWS_REGION:-ap-northeast-1}"
  [[ "$name" =~ ^[A-Za-z0-9_.-]{1,64}$ ]] || { echo "invalid profile name: $name" >&2; exit 64; }
  [[ "$region" =~ ^[a-z0-9-]{1,32}$ ]] || { echo "invalid region: $region" >&2; exit 64; }
  [[ "$ct_id" =~ ^[0-9]{1,6}$ ]] || { echo "invalid CT id: $ct_id" >&2; exit 64; }

  local status
  status=$(ssh -n "root@${pve_host}" "pct status ${ct_id}" 2>&1)
  case "$status" in
    *running*) ;;
    *) echo "CT ${ct_id} is not running on ${pve_host}: ${status}" >&2; exit 1 ;;
  esac

  local akid sak
  if (( from_stdin )); then
    if [[ -t 0 ]]; then
      read -r -p "aws_access_key_id for ${name}: " akid
      read -r -s -p "aws_secret_access_key for ${name}: " sak
      echo >&2
    else
      IFS= read -r akid || true
      IFS= read -r sak || true
    fi
  else
    akid=$(ssh -n "root@${pve_host}" "aws configure get aws_access_key_id --profile ${name}")
    sak=$(ssh -n "root@${pve_host}" "aws configure get aws_secret_access_key --profile ${name}")
  fi
  if [[ -z "$akid" || -z "$sak" ]]; then
    echo "no key pair for ${name} (stdin empty, or the PVE host lacks the profile)" >&2
    exit 1
  fi

  # The script travels as base64 in argv (it holds no secret; its alphabet is
  # inert at every shell layer); the key pair travels on stdin.
  local script b64
  script=$(printf 'PROFILE=%s\nREGION=%s\n%s\n' "$name" "$region" "$CT_ADD_PROFILE_SCRIPT")
  b64=$(printf '%s' "$script" | base64 | tr -d '\n')
  printf '%s\n%s\n' "$akid" "$sak" |
    ssh "root@${pve_host}" "pct exec ${ct_id} -- bash -c 'eval \"\$(printf %s ${b64} | base64 -d)\"'"
  akid=""
  sak=""

  if ssh -n "root@${pve_host}" \
       "pct exec ${ct_id} -- timeout 10 aws sts get-caller-identity --profile ${name}" \
       >/dev/null 2>&1; then
    echo "OK: ${name} profile placed on CT ${ct_id} and usable (other profiles untouched)"
  else
    echo "WARN: ${name} profile placed on CT ${ct_id}, but sts get-caller-identity failed with it" >&2
    exit 2
  fi
}

if [[ "${1:-}" == "--profile" ]]; then
  shift
  add_profile_mode "$@"
  exit 0
fi

CT_ID="${1:?Usage: bootstrap-lxc-creds <CT_ID>}"
PVE_HOST="${PVE_HOST:-192.168.1.10}"
AWS_PROFILE="${AWS_PROFILE:-pve-bootstrap-ssm}"
AWS_REGION="${AWS_REGION:-ap-northeast-1}"

# Verify CT is running before any creds I/O
status=$(ssh -n "root@${PVE_HOST}" "pct status ${CT_ID}" 2>&1)
case "$status" in
  *running*) ;;
  *) echo "CT ${CT_ID} is not running on ${PVE_HOST}: ${status}" >&2; exit 1 ;;
esac

# Phase B-2: skip if creds already valid (lazy re-seed). Avoids re-writing
# /root/.aws/credentials on every orchestrator cycle when the LXC already
# has working creds. Only re-seeds when the existing creds are missing,
# expired, or revoked (e.g. after B-1 IAM key rotation).
if ssh -n "root@${PVE_HOST}" \
     "pct exec ${CT_ID} -- timeout 5 aws sts get-caller-identity --profile ${AWS_PROFILE}" \
     >/dev/null 2>&1; then
  echo "OK: ${AWS_PROFILE} profile already valid on CT ${CT_ID}, skipping seed"
  exit 0
fi

# Read source creds from PVE host's profile
AKID=$(ssh -n "root@${PVE_HOST}" "aws configure get aws_access_key_id --profile ${AWS_PROFILE}")
SAK=$(ssh -n "root@${PVE_HOST}" "aws configure get aws_secret_access_key --profile ${AWS_PROFILE}")
if [[ -z "$AKID" || -z "$SAK" ]]; then
  echo "PVE host ${PVE_HOST} is missing the ${AWS_PROFILE} profile" >&2
  exit 1
fi

# Write the profile inside the target LXC (root home, 0600).
# Using `pct exec` keeps the operation host-internal — no need to
# distribute creds over SSH back to the LXC's own network address.
#
# Phase B-2: LXC-internal flock guards against concurrent invocations
# on the same CT (e.g. orchestrator + manual run from a different host).
# The lock lives inside the LXC filesystem so it works regardless of who
# the caller is (PVE host orchestrator / a different operator's Mac).
# Exit 75 (EAGAIN) signals "another bootstrap in progress" — orchestrator
# treats this as warn-and-continue (not a fatal error).
ssh -n "root@${PVE_HOST}" "pct exec ${CT_ID} -- bash -lc '
  flock -n /var/lock/aws-creds-bootstrap.lock bash -c \"
    mkdir -p /root/.aws && chmod 700 /root/.aws
    cat > /root/.aws/credentials <<EOF
[${AWS_PROFILE}]
aws_access_key_id = ${AKID}
aws_secret_access_key = ${SAK}
EOF
    cat > /root/.aws/config <<EOF
[profile ${AWS_PROFILE}]
region = ${AWS_REGION}
EOF
    chmod 600 /root/.aws/credentials /root/.aws/config
  \" || { echo \"another bootstrap in progress for CT ${CT_ID}\" >&2; exit 75; }
'"

echo "OK: ${AWS_PROFILE} profile seeded on CT ${CT_ID}"
