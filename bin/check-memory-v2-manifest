#!/usr/bin/env bash
# Guardrail for the memory-v2 distribution units (ADR 0010).
#
# For each unit under cookbooks/lxc-es-memory/files/{memory-mcp,memory-keeper}:
#   1. MANIFEST lists every runtime file in the directory (every *.py that is
#      not a test_*.py, every prompts/*.md) — a new module that is committed
#      but not listed is exactly the #895 merge_rules.py failure (keeper
#      ModuleNotFoundError on every tick for 4 days).
#   2. every MANIFEST entry exists.
#   3. ARTIFACT INSTALL: copy ONLY the MANIFEST files into an empty directory —
#      the same file set the cookbook deploys — and import every module from
#      there with `python3 -I` (no user site, no PYTHONPATH, cwd inserted
#      explicitly). The interpreter's own stdlib/site-packages remain, so the
#      guarantee is "the source tree can no longer accidentally complete a
#      missing file", not a fully sealed environment. memory-keeper is stdlib-only, so
#      this runs with the system python3; memory-mcp needs its
#      requirements-v2.txt wheels, which the caller provides via
#      MEMORY_MCP_PYTHON (a venv python with those wheels installed) — when it
#      is unset the mcp import step is SKIPPED and reported as such.
#   4. the keeper's own unit tests run against the INSTALLED copy.
#
# Usage: bin/check-memory-v2-manifest [BASE]     # exit 1 on any failure
#        BASE defaults to cookbooks/lxc-es-memory/files
#        MEMORY_MCP_PYTHON=.venv/bin/python bin/check-memory-v2-manifest
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE="$(cd "${1:-$REPO/cookbooks/lxc-es-memory/files}" && pwd)"
fail=0
T=$(mktemp -d "${TMPDIR:-/tmp}/memory-v2-artifact.XXXXXX"); trap 'rm -rf "$T"' EXIT

# Normalize the same way the cookbook's placement does (`manifest` in
# cookbooks/lxc-es-memory/default.rb) — otherwise a
# MANIFEST line the cookbook accepts (" scoring.py ", trailing CR) can
# mismatch the checker's own file-exists / shape checks (review D5).
manifest_entries() { grep -vE '^\s*(#|$)' "$BASE/$1/MANIFEST" | sed 's/\r$//; s/^[[:space:]]*//; s/[[:space:]]*$//'; }

for unit in memory-mcp memory-keeper; do
  echo "== $unit"
  dir="$BASE/$unit"
  # 1. EVERY file in the unit directory is either a listed runtime file, a
  #    test (test_*.py, CI-only), or the MANIFEST itself. Any other file —
  #    data, templates, nested modules, symlinks — FAILS: the cookbook does
  #    not deploy it and this unit's shape does not allow it (review F3).
  while IFS= read -r f; do
    case "$f" in MANIFEST|test_*.py|conformance/session_redact_r*.jsonl|conformance/session_codex_v*.jsonl|conformance/gen_vectors.py) continue ;; esac
    grep -qxF "$f" "$dir/MANIFEST" || { echo "FAIL  $unit: $f exists but is not in MANIFEST (would not be deployed)"; fail=1; }
  done < <(cd "$dir" && find . -mindepth 1 \( -type f -o -type l \) | sed 's#^\./##' | sort)
  # 2. every listed file exists AND has a shape the cookbook can deploy: a
  #    top-level *.py for both units, plus prompts/*.md ONLY for memory-keeper
  #    — its recipe creates keeper_dir/prompts before the MANIFEST loop;
  #    memory-mcp's loop has no such directory resource, so a prompts/*.md
  #    entry there would pass this check and then fail on the LXC with
  #    `cp: No such file or directory` (review D1). A deeper path than either
  #    shape would pass a copy-based check and fail the same way (review F2).
  #    A symlink entry is also rejected here: `-f` follows the link and `cp`
  #    copies the link's target content, so a symlink can smuggle in a file
  #    outside the unit's own directory (review D3).
  while IFS= read -r f; do
    [[ -f "$dir/$f" ]] || { echo "FAIL  $unit: MANIFEST lists $f but it does not exist"; fail=1; }
    [[ -L "$dir/$f" ]] && { echo "FAIL  $unit: MANIFEST entry $f is a symlink — not a plain file the cookbook can deploy"; fail=1; }
    shape_ok=0
    [[ "$f" =~ ^[A-Za-z0-9_]+\.py$ ]] && shape_ok=1
    [[ "$unit" == memory-keeper && "$f" =~ ^prompts/[A-Za-z0-9_-]+\.md$ ]] && shape_ok=1
    [[ $shape_ok -eq 1 ]] \
      || { echo "FAIL  $unit: MANIFEST entry $f is not a shape this unit's cookbook recipe creates a directory for (top-level .py; prompts/*.md only for memory-keeper)"; fail=1; }
  done < <(manifest_entries "$unit")
  # 3. artifact install into an empty dir
  inst="$T/$unit"; mkdir -p "$inst"
  while IFS= read -r f; do
    mkdir -p "$inst/$(dirname "$f")"; cp "$dir/$f" "$inst/$f"
  done < <(manifest_entries "$unit")
  mods=$(manifest_entries "$unit" | grep -E '^[^/]+\.py$' | sed 's/\.py$//' | tr '\n' ' ')
  # server.py runs `asyncio.run(be.ensure_indices())` at IMPORT time (ES
  # bootstrap coupled to module load), so a hermetic import would try to reach
  # ES. It is byte-compiled AND its third-party import lines (mcp / starlette /
  # httpx / uvicorn) are executed against the real wheels — the mcp 2.x
  # `mcp.server.fastmcp` removal that crash-looped the unit in 2026-08 is
  # exactly an import-line failure (review F7). The four leaf modules import
  # for real. Decoupling the bootstrap into the lifespan is the next step.
  compile_only=""
  if [[ "$unit" == memory-mcp ]]; then compile_only="server"; mods=$(tr ' ' '\n' <<<"$mods" | grep -vx server | tr '\n' ' '); fi
  py=python3
  if [[ "$unit" == memory-mcp ]]; then
    if [[ -n "${MEMORY_MCP_PYTHON:-}" ]]; then py="$(cd "$(dirname "$MEMORY_MCP_PYTHON")" && pwd)/$(basename "$MEMORY_MCP_PYTHON")"; else
      echo "SKIP  $unit: import check needs requirements-v2.txt wheels — set MEMORY_MCP_PYTHON"; py=""; fi
  fi
  # Import-time REQUIRED env (os.environ["..."] at module top level). The systemd
  # units get these from the generated env file; the artifact check supplies
  # placeholders — it proves the file set is complete and importable, it does
  # not talk to ES or Voyage.
  export VOYAGE_API_KEY="${VOYAGE_API_KEY:-artifact-check-placeholder}"
  export ES_URL="${ES_URL:-http://127.0.0.1:9}"          # port 9 = discard; nothing connects at import
  export ES_PASSWORD="${ES_PASSWORD:-artifact-check-placeholder}"
  if [[ -n "$py" ]]; then
    # -I isolates (no user site, no env) and drops cwd from sys.path; the units
    # run as `python3 /opt/.../<module>.py`, which puts the install dir first on
    # sys.path — insert cwd explicitly to match that and nothing else.
    if (cd "$inst" && "$py" -I -c "import importlib,os,sys; sys.path.insert(0, os.getcwd()); [importlib.import_module(m) for m in sys.argv[1:]]" $mods 2>"$T/$unit.err") \
       && { [[ -z "$compile_only" ]] || (cd "$inst" && "$py" -I -m py_compile "$compile_only.py" 2>>"$T/$unit.err"); } \
       && { [[ -z "$compile_only" ]] || (cd "$inst" && grep -hE '^(from|import) (mcp|starlette|httpx|uvicorn)\b' "$compile_only.py" | "$py" -I - 2>>"$T/$unit.err"); }; then
      echo "PASS  $unit: installed artifact imports cleanly ($mods)${compile_only:+; $compile_only.py byte-compiles + its mcp/starlette import lines resolve against the wheels (import-time ES bootstrap keeps the module itself un-importable here, ADR 0010)}"
    else
      echo "FAIL  $unit: import from the installed artifact failed:"; sed 's/^/      /' "$T/$unit.err"; fail=1
    fi
  fi
  # 4. unit tests against the installed copy
  if [[ "$unit" == memory-keeper ]]; then
    if (cd "$inst" && cp "$dir"/test_*.py . && python3 -I test_merge_rules.py >"$T/keeper-tests.log" 2>&1); then
      echo "PASS  $unit: test_merge_rules.py against the installed copy"
    else
      echo "FAIL  $unit: keeper tests against the installed copy:"; tail -20 "$T/keeper-tests.log" | sed 's/^/      /'; fail=1
    fi
  fi
done
# 5. The session redactor and the codex adapter have ONE source (memory-mcp/,
#    design spec §6.2). shin1ohno/session-search vendors copies, deployed inside
#    the ccs package (ADR 0014); at the pin they must be byte-identical to the
#    server's, or the client masks with one ruleset while the server re-scans
#    with another and every mismatch becomes a 422 (or worse, a secret the client
#    no longer masks). Equal OIDs are equal bytes. A copy that is missing or
#    cannot be fetched is a failure: nothing here passes vacuously.
source "$REPO/bin/lib/session-search-era.sh"
source "$REPO/bin/lib/session-search-artifact.sh"
ss_pin_file="${SESSION_SEARCH_PIN_FILE:-$REPO/cookbooks/session-search/session-search.pin}"
ss_rust_file="${SESSION_SEARCH_RUST_FILE:-$(dirname "$ss_pin_file")/session-search.rust}"
ss_origin=${SESSION_SEARCH_ORIGIN:-https://github.com/shin1ohno/session-search.git}
ss_co="$T/session-search"
ss_git() { GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 git "$@"; }
ss_pin="$(cat "$ss_pin_file" 2>/dev/null || true)"
if ! [[ "$ss_pin" =~ ^[0-9a-f]{40}$ ]]; then
  echo "FAIL  session-search.pin: $ss_pin_file is not one 40-hex SHA"; fail=1
elif ! { ss_git init -q "$ss_co" && ss_git -C "$ss_co" fetch -q --no-tags "$ss_origin" +refs/heads/main:refs/remotes/origin/main; }; then
  echo "FAIL  session-search: pin $ss_pin cannot be fetched from $ss_origin"; fail=1
else
  for f in session_redact.py session_codex.py; do
    server="$BASE/memory-mcp/$f"
    vendored="vendor/memory-mcp/$f"
    want="$(ss_git -C "$ss_co" rev-parse -q --verify "$ss_pin:$vendored" || true)"
    if [[ ! -f "$server" ]]; then
      echo "FAIL  $f: no server file at $server"; fail=1
    elif [[ -z "$want" ]]; then
      echo "FAIL  $f: session-search has no $vendored at the pin $ss_pin"; fail=1
    elif [[ "$(ss_git hash-object --no-filters "$server")" == "$want" ]]; then
      echo "PASS  $f: $vendored at the pin is byte-identical to memory-mcp/$f"
    else
      echo "FAIL  $f: $vendored at the pin $ss_pin differs from memory-mcp/$f (update the vendored copy in session-search, then move the pin)"; fail=1
    fi
  done
  if ! ss_era "$ss_co" "$ss_pin" "$ss_rust_file"; then
    fail=1
  elif [[ "$ss_pin_era" == python ]]; then
    ss_python_tree "$ss_co" "$ss_pin" "$BASE/memory-mcp" || fail=1
  else
    # BASE remains the caller-selected authoritative server tree. The checker
    # is the setup policy, independent of executable code in the pin's tree.
    for suite in redact codex; do
      case "$suite" in redact) corpus=session_redact_r1.jsonl ;; codex) corpus=session_codex_v1.jsonl ;; esac
      expected=$(ss_git -C "$ss_co" rev-parse "$ss_pin:vendor/memory-mcp/conformance/$corpus" || true)
      if [[ -z "$expected" || "$expected" != "$(ss_git hash-object --no-filters "$BASE/memory-mcp/conformance/$corpus")" ]]; then
        echo "FAIL  $suite: pinned corpus differs from server"; fail=1
      fi
    done
    case "$(uname -s)-$(uname -m)" in
      Darwin-arm64) ss_target=aarch64-apple-darwin ;;
      Linux-aarch64) ss_target=aarch64-unknown-linux-gnu ;;
      Linux-x86_64) ss_target=x86_64-unknown-linux-gnu ;;
      *) echo 'FAIL unsupported conformance runner'; exit 1 ;;
    esac
    if ss_artifact "$ss_pin" "$ss_target" "$T/ccs"; then
      for suite in redact codex; do
        case "$suite" in redact) corpus=session_redact_r1.jsonl ;; codex) corpus=session_codex_v1.jsonl ;; esac
        if ! "$T/ccs" _conformance "$suite" < "$BASE/memory-mcp/conformance/$corpus"; then
          echo "FAIL  $suite: artifact conformance failed"; fail=1
        fi
      done
      if "$T/ccs" _conformance redact --emit < "$BASE/memory-mcp/conformance/session_redact_r1.jsonl" > "$T/emit.jsonl"; then
        python3 -B -I "$REPO/bin/lib/session-search-conformance.py" --server "$BASE/memory-mcp" --emit "$T/emit.jsonl" || fail=1
      else echo 'FAIL  redact: artifact conformance emit failed'; fail=1; fi
      if "$T/ccs" _buildinfo > "$T/buildinfo.json"; then
        python3 -B -I - "$BASE/memory-mcp" "$T/buildinfo.json" "$ss_pin" "$ss_target" <<'PY' || fail=1
import importlib.util, json, pathlib, sys
spec = importlib.util.spec_from_file_location("redactor", pathlib.Path(sys.argv[1]) / "session_redact.py")
sr = importlib.util.module_from_spec(spec); spec.loader.exec_module(sr)
info = json.loads(pathlib.Path(sys.argv[2]).read_text())
assert info["commit"] == sys.argv[3] and info["target"] == sys.argv[4], "build identity mismatch"
assert info["redact_version"] in sr.SUPPORTED_VERSIONS, "unsupported redact_version"
print("PASS build identity and supported ruleset")
PY
      else fail=1; fi
    else fail=1; fi
  fi
fi
# A rejected distribution cannot pass; avoid re-running the full server
# corpus after an earlier mandatory check has already failed.
[[ $fail -eq 0 ]] || { echo 'FAIL: distribution checks failed above'; exit 1; }
# S0 corpora are test artifacts, never MANIFEST runtime files. Older pinned
# server trees predate them; a partial import must not silently skip a suite.
if [[ -d "$BASE/memory-mcp/conformance" ]]; then
  for suite in redact codex; do
    if "${MEMORY_MCP_PYTHON:-python3}" -B -I "$BASE/memory-mcp/test_session_${suite}_conformance.py"; then
      echo "PASS  session_${suite}: server conformance corpus"
    else
      echo "FAIL  session_${suite}: server conformance corpus"; fail=1
    fi
  done
else
  echo 'FAIL conformance corpus is required from S1'; fail=1
fi
[[ $fail -eq 0 ]] && echo "OK: memory-v2 distribution units are complete and importable." || { echo "FAIL: see above"; exit 1; }
