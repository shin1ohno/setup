#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Guardrail (Phase 0 of docs/refactoring/plan.md): static checks for the
# mitamae footguns codified in ~/.claude/rules/ruby.md. Runs over every recipe
# (.rb under cookbooks/ roles/ pve/ + the root entry recipes), skipping
# cookbooks/*/files/** (those are shipped artifacts, not recipes).
#
# Findings come in two tiers. FAIL findings land in `violations` and exit 1;
# WARN findings land in `warnings`, print in their own block, and leave the exit
# code alone — the tier for a drift class that is real but whose current hits are
# known/accepted. Promoting a check is a one-line move between the two arrays.
#
# Checks (1-8 are FAIL tier):
#   1. top-level `if/unless File.exist?`  — compile-time eval reads pre-converge
#      state ("Mitamae evaluation model — top-level Ruby is compile-time").
#      Code inside a `def` is exempt (runs at call time). allowlist: see ALLOW1.
#   2. Integer `owner`/`group`            — mitamae requires String ("owner
#      attribute should be String"). `owner "1000"` ok, `owner 1000` fails.
#   3. check_command profile MISMATCH     — the require_external_auth gate's
#      profile must match the profiles used by the gated cookbook's actual aws
#      operations ("Auth-check gate must match the cookbook's actual invocation
#      profile"). bare<->bare is consistent and passes. allowlist: see ALLOW3.
#   4. notify-driven `docker compose up -d` missing `--force-recreate` — a bare
#      `up -d` is a no-op on running containers, so bind-mounted config edits
#      never take effect ("Notify-Driven Restart Requires --force-recreate").
#      Only flags `action :nothing` execs (the notify path); `ensure running`
#      execs with `only_if` correctly use plain `up -d`.
#   5. fully-BARE require_external_auth gate (no --profile/AWS_PROFILE) — profile
#      auto-discovery is TTY-only, so a bare gate is non-deterministic on the
#      unattended NON-TTY fleet (the cognee/memory/hydra silent .env-skip class).
#      Fleet cookbooks must pin an explicit --profile; darwin auto-discovery
#      cookbooks are listed in BARE_OK. allowlist: see BARE_OK (+ ALLOW3).
#   6. claude-code deploy-list drift        — files/{rules,docs,workflows,agents}/
#      are deployed via explicit %w() lists, not Dir.glob, so a new file is a
#      silent orphan until its name is added to the matching list. files/skills/
#      is checked too: its loop ships only <name>/SKILL.md, so any helper script
#      or template beside it needs its own remote_file (test-only trees are
#      exempted by skills_exempt in the check).
#   7. `owner` without `group`              — mitamae then chowns to the group it
#      reads off the existing path, and on a host whose login user is NSS-virtual
#      (GCE OS Login) it cannot read one, emitting the literal
#      `chown <user>:UNKNOWN` and failing the resource. Swept three times
#      (#778/#788, 50 sites); this stops a fourth.
#   8. mruby-absent CRuby methods in recipe Ruby — mitamae runs mruby, so
#      File.mtime/stat/size, Integer#zero?, Regexp.last_match(n), filter_map and
#      each_with_object abort at converge while `ruby -c` stays green. The
#      dry-run jobs only catch what they EXECUTE, so anything behind
#      require_external_auth's non-TTY return is invisible to CI (how
#      Regexp.last_match(1) shipped). Comment lines are skipped; `dig` is NOT in
#      the set (35 legitimate uses on mitamae's node object).
#   9. [FAIL] FLEET <-> edge-agent config drift — host-profile's `fleet` table is
#      the offline identity mirror every host keys off, and edge-agent ships one
#      files/config-<label>.toml per fleet host. Either direction can rot: a new
#      fleet label with no config makes edge-agent fall back silently, and a
#      config for a label nobody resolves is dead weight that reads as coverage.
#      Exempt: sh1-cloud (guarded out of linux.rb) and es-N (ES LXCs are not
#      edge-agent targets).
#  10. [WARN] hosts.json <-> pve/*.rb <-> FLEET drift — the orchestrator only
#      converges hosts listed in auto-mitamae-orchestrator/files/hosts.json, so a
#      pve/lxc-*.rb absent from it is a CT that never auto-applies, and a
#      hosts.json role pointing at a missing recipe fails at push time. Also
#      cross-checks the es-N FLEET `ip` against the hosts.json `host` — two
#      hand-maintained copies of one address. Exempt: pve/lxc-apm-server.rb
#      (documented opt-out; it deliberately skips lxc_entry).
#  11. [WARN] `case node[:platform]` with no `else` — an unknown platform falls
#      through to nil instead of failing, so the recipe converges "successfully"
#      with an unset path/package. Heredoc bodies are skipped so shell `if` in an
#      add_profile block does not unbalance the walk.
#  12. [FAIL] `node[:platform]` inside cookbooks/ (ratchet) — OS branching
#      belongs at the entry/role layer (hurdle-removal plan stream B: per-OS
#      recipes selected by the caller, install_package / platform_value /
#      host-profile facts for values). PLATFORM_PENDING freezes the
#      pre-migration state: a file listed there may still reference
#      node[:platform] (it is the burn-down list), any OTHER cookbook file may
#      not, and a migrated file MUST drop its PENDING entry in the same PR.
#      Allowlist: functions + host-profile — the platform abstraction owners.
#  13. [FAIL] existence-only `skip_if` on a require_external_auth gate (ratchet)
#      — `-> { File.exist?(path) }` makes the gate skip forever on every
#      already-converged host, so a NEW key added to the generator is silently
#      dropped and a truncated/error-text artifact counts as done. The
#      predicate must read CONTENT: file_has_all?, File.read, or a
#      run_command/system shell probe (the form to use when the file is
#      root-only-readable and mitamae runs non-root). Negated existence
#      (`!File.exist?`) is exempt — that is a prerequisite check, not a
#      done-claim. SKIPIF_PENDING freezes the pre-migration state exactly like
#      check 12: a listed file may still have a raw site, any other file may
#      not, and migrating MUST drop the entry in the same PR.
#
# Usage:  bin/lint-cookbooks   # exit 1 on any FAIL-tier violation (WARN never
#                              # affects the exit code)

require "json"
require "set"

REPO_ROOT = File.expand_path("..", __dir__)
Dir.chdir(REPO_ROOT)

# --- allowlists ------------------------------------------------------------

# Check 1: top-level File.exist? that is intentionally compile-time safe.
ALLOW1 = {
  # Reads a user-managed local override, not a resource side effect.
  "roles/manage/default.rb" => [14],
  # Fail-fast diagnostic: `exit 1` if brew is installed (prefix dir exists) but
  # not on PATH, using the prior-run profile.d fragment as the "PATH already
  # wired" signal. NOT the resource-declaration footgun — it aborts loudly, it
  # does not silently skip resources based on a file a converge step creates
  # this run.
  "cookbooks/homebrew/default.rb" => [3],
}.freeze

# Check 3: cookbooks whose bare/STS auth gate is correct by design.
#   mcp / codex-cli run on darwin where `aws login`'s DEFAULT profile is the
#   right credential — adding --profile would break Mac MCP auth (case B, D5).
ALLOW3 = %w[
  cookbooks/mcp/default.rb
  cookbooks/codex-cli/default.rb
].to_set

# Check 5: cookbooks whose FULLY-BARE auth gate (no --profile/AWS_PROFILE) is
# intentional. Two cases:
#   - darwin-only stacks (local-mcp) rely on require_external_auth's profile
#     auto-discovery, which is TTY-only on darwin.
#   - fleet+darwin shared cookbooks (ssh-keys) rely on TTY auto-discovery on
#     darwin AND on AWS_PROFILE preset by the fleet entry point
#     (cookbooks/auto-mitamae-target/files/mitamae-runner.sh exports
#     AWS_PROFILE=pve-bootstrap-ssm before invoking mitamae). Both branches
#     converge on a working profile without per-cookbook --profile pinning.
# Everything NOT listed here (and not in ALLOW3, which is skipped wholesale)
# must pin an explicit --profile. mcp/codex-cli are already covered by ALLOW3.
BARE_OK = %w[
  cookbooks/ssh-keys/default.rb
].to_set

# --- file discovery --------------------------------------------------------

recipe_files =
  (Dir["cookbooks/**/*.rb"] + Dir["roles/**/*.rb"] + Dir["pve/*.rb"] +
   ["darwin.rb", "linux.rb", "test-cookbook.rb"])
  .reject { |p| p.include?("/files/") }
  .select { |p| File.file?(p) }
  .sort
  .uniq

violations = [] # FAIL tier — exit 1
warnings   = [] # WARN tier — reported separately, exit code unaffected

def add(bucket, file, lineno, msg)
  bucket << "#{file}:#{lineno}: #{msg}"
end

# --- check 1: top-level File.exist? ----------------------------------------

# Flag File.exist? inside a top-level `if`/`unless` CONDITION, including
# multi-line conditions (e.g. `if a && \n  b && \n  File.exist?(...)`). Code
# inside a `def` body is exempt (runs at call time, not compile time).
#
# KNOWN LIMITATION: only a `def` body is exempt, so an `if File.exist?(...)`
# inside an only_if / not_if / skip_if Proc is flagged even though a Proc body
# also runs at converge, not compile, time. Write the predicate into a local and
# test the local (see cookbooks/zsh/default.rb's .bash_profile guard) rather
# than allowlisting a line number here — ALLOW1 entries go stale on the next
# insertion above them.
CONT = /(?:&&|\|\||\\|\band\b|\bor\b)\z/ # line continues the condition

recipe_files.each do |file|
  lines = File.readlines(file).map { |l| l.chomp }
  def_stack = [] # indentation columns of open `def`s
  i = 0
  while i < lines.length
    raw = lines[i]
    indent = raw[/\A */].length
    if raw =~ /\A\s*def\b/
      def_stack.push(indent); i += 1; next
    end
    if raw =~ /\A\s*end\b/ && !def_stack.empty? && indent == def_stack.last
      def_stack.pop; i += 1; next
    end
    if def_stack.empty? && raw =~ /\A\s*(if|unless)\b/
      kw = Regexp.last_match(1)
      cond = [raw]
      j = i
      while lines[j] && lines[j].rstrip =~ CONT
        j += 1
        cond << lines[j] if lines[j]
      end
      if cond.join("\n") =~ /File\.exist/ && !(ALLOW1[file]&.include?(i + 1))
        add(violations, file, i + 1,
            "top-level `#{kw} ... File.exist?` runs at compile time (pre-converge " \
            "state). Use a resource-level only_if/not_if, or allowlist in " \
            "bin/lint-cookbooks ALLOW1 with justification.")
      end
      i = j + 1
      next
    end
    i += 1
  end
end

# --- check 2: Integer owner/group ------------------------------------------

recipe_files.each do |file|
  File.foreach(file).with_index(1) do |raw, lineno|
    next if raw =~ /\A\s*#/
    next unless raw =~ /\A\s*(owner|group)\s+(\d)/
    add(violations, file, lineno,
        "Integer `#{Regexp.last_match(1)}` — mitamae requires a String " \
        "(e.g. owner \"1000\", not owner 1000).")
  end
end

# --- check 3: check_command profile MISMATCH -------------------------------
#
# Scope limits (sound on this repo, documented so a future change is reviewed):
#  - per-file profile union: assumes one cookbook gates a single profile. A
#    cookbook legitimately using two distinct named profiles would need this
#    relaxed (none does today).
#  - a bare aws op is only counted when the file has NO profile token anywhere
#    in its op region (otherwise bare-looking calls are assumed to inherit a
#    file-level AWS_PROFILE=).
#  - STS-only gates and non-line-start `check_command:` keywords are not
#    compared (none exist outside the ALLOW3 darwin cookbooks).

# Classify a command string by the AWS profile it uses.
def profile_of(cmd)
  return :sts if cmd =~ /\baws\s+sts\b/
  if cmd =~ /--profile\s+(\S+)/ || cmd =~ /AWS_PROFILE=(\S+)/
    return Regexp.last_match(1).gsub(/['"]/, "").sub(/[,)]+\z/, "")
  end
  :bare
end

# Join a logical (possibly backslash-continued) statement starting at `lines[i]`
# and return [joined_text, next_index].
def join_continuation(lines, i)
  buf = []
  j = i
  loop do
    line = lines[j]
    buf << line
    break unless line.rstrip.end_with?("\\")
    j += 1
    break if j >= lines.length
  end
  [buf.join("\n"), j]
end

# Concatenate all double-quoted segments in a blob (Ruby adjacent-string concat).
def quoted_concat(blob)
  blob.scan(/"((?:[^"\\]|\\.)*)"/).map { |m| m[0] }.join
end

# Resolve a scalar `var = "..."` (with continuation / concat) from file lines.
def resolve_var(var, lines)
  lines.each_with_index do |line, i|
    next unless line =~ /\A\s*#{Regexp.escape(var)}\s*=\s*/
    blob, = join_continuation(lines, i)
    blob = blob.sub(/\A\s*#{Regexp.escape(var)}\s*=\s*/, "")
    return quoted_concat(blob)
  end
  nil
end

recipe_files.each do |file|
  next if ALLOW3.include?(file)
  text  = File.read(file)
  next unless text.include?("require_external_auth")
  lines = text.lines.map(&:chomp)

  arg_line_idx = Set.new # 0-based line indices inside a require_external_auth(...) arg list
  gate_profiles = Set.new

  i = 0
  while i < lines.length
    line = lines[i]
    if line !~ /\A\s*#/ && line =~ /\brequire_external_auth\s*\(/
      # Walk paren depth from this line to the matching close.
      depth = 0
      started = false
      j = i
      check_lines = []
      while j < lines.length
        l = lines[j]
        arg_line_idx << j
        check_lines << l
        l.each_char do |c|
          if c == "("
            depth += 1; started = true
          elsif c == ")"
            depth -= 1
          end
        end
        break if started && depth <= 0
        j += 1
      end
      # Extract check_command value from the captured arg lines.
      ci = check_lines.index { |l| l =~ /\A\s*check_command:/ }
      if ci
        blob, = join_continuation(check_lines, ci)
        blob = blob.sub(/\A\s*check_command:\s*/, "")
        cmd =
          if blob =~ /\A([a-z_]\w*)\s*,?\s*\z/ # bare identifier -> variable
            resolve_var(Regexp.last_match(1), lines) || ""
          else
            quoted_concat(blob)
          end
        gate_profiles << profile_of(cmd) unless cmd.empty?
      end
      i = j + 1
      next
    end
    i += 1
  end

  next if gate_profiles.empty?

  # Operation profiles: scan everything OUTSIDE the gate arg-lists for the aws
  # profiles the cookbook actually uses (--profile / AWS_PROFILE=), and whether
  # any bare `aws ssm|sts` op exists.
  op_profiles = Set.new
  op_has_bare = false
  lines.each_with_index do |line, idx|
    next if arg_line_idx.include?(idx)
    next if line =~ /\A\s*#/
    line.scan(/--profile\s+(\S+)/) { |m| op_profiles << m[0].gsub(/['"]/, "").sub(/[,)]+\z/, "") }
    line.scan(/AWS_PROFILE=(\S+)/)  { |m| op_profiles << m[0].gsub(/['"]/, "").sub(/[,)]+\z/, "") }
  end
  # bare op = an aws ssm/sts invocation in op-region with no profile anywhere in
  # the file's op-region (if the file sets AWS_PROFILE= somewhere, bare-looking
  # aws calls are assumed to inherit it).
  if op_profiles.empty?
    lines.each_with_index do |line, idx|
      next if arg_line_idx.include?(idx)
      next if line =~ /\A\s*#/
      if line =~ /\baws\s+(?:ssm|sts)\b/
        op_has_bare = true
        break
      end
    end
  end

  # Reduce the gate to a single representative profile.
  concrete = gate_profiles.reject { |p| p == :sts }
  next if concrete.empty? # STS-only gate (allowlisted styles) — nothing to compare

  if concrete == [:bare]
    unless op_profiles.empty?
      add(violations, file, 1,
          "auth gate uses a BARE check_command but the cookbook's aws operations " \
          "use profile(s) #{op_profiles.to_a.inspect}. Gate and operations must " \
          "use the same profile (~/.claude/rules/ruby.md auth-check gate rule).")
    end
  else
    gp = concrete.reject { |p| p == :bare }
    extra = op_profiles - gp.to_set
    if !extra.empty?
      add(violations, file, 1,
          "auth gate uses profile(s) #{gp.inspect} but aws operations also use " \
          "#{extra.to_a.inspect}. Make check_command and the gated aws calls use " \
          "the same --profile/AWS_PROFILE.")
    elsif op_has_bare
      add(violations, file, 1,
          "auth gate uses profile(s) #{gp.inspect} but the cookbook has BARE aws " \
          "operations (no --profile/AWS_PROFILE). Add the same profile to every " \
          "aws ssm/sts call in the gated block.")
    end
  end
end

# --- check 4: notify-driven compose up -d without --force-recreate ---------

recipe_files.each do |file|
  lines = File.readlines(file)
  i = 0
  while i < lines.length
    line = lines[i]
    if line =~ /\A(\s*)execute\b.*\bdo\b/
      indent = Regexp.last_match(1).length
      block = [line]
      start = i
      j = i + 1
      while j < lines.length
        block << lines[j]
        break if lines[j] =~ /\A {#{indent}}end\b/ || lines[j] =~ /\A\t*end\b/ && lines[j][/\A */].length == indent
        j += 1
      end
      body = block.join
      compose = body =~ /docker[- ]compose\b.*\bup -d/m
      forced  = body.include?("--force-recreate")
      notify_driven = body =~ /\baction\s+:nothing\b/
      if compose && !forced && notify_driven
        add(violations, file, start + 1,
            "notify-driven `docker compose up -d` is missing --force-recreate " \
            "(bare up -d is a no-op on running containers, so config edits are " \
            "silently dropped). See ~/.claude/rules/docker-compose.md.")
      end
      i = j + 1
      next
    end
    i += 1
  end
end

# --- check 5: fully-bare auth gate (require_external_auth OR deploy_with_ssm_env) ---
#
# A gate whose check_command carries NO profile (no --profile / no AWS_PROFILE=)
# relies on require_external_auth's profile auto-discovery, which is TTY-only. On
# the unattended NON-TTY fleet auto-discovery never runs, so a bare gate falls
# through to a non-deterministic ambient profile — the cognee/memory/hydra silent
# .env-skip class. Fleet cookbooks must pin an explicit --profile; darwin
# auto-discovery cookbooks are listed in BARE_OK (mcp/codex-cli via ALLOW3).
# Covers BOTH gate forms: `require_external_auth(check_command: "...")` and the
# `deploy_with_ssm_env "..." do; check_command "..."; end` DSL setter.

recipe_files.each do |file|
  next if ALLOW3.include?(file) || BARE_OK.include?(file)
  text = File.read(file)
  next unless text.include?("require_external_auth") || text.include?("deploy_with_ssm_env")
  lines = text.lines.map(&:chomp)
  flagged = false
  lines.each_with_index do |l, idx|
    break if flagged
    next if l =~ /\A\s*#/
    next unless l =~ /\A\s*check_command[:\s]/
    blob, = join_continuation(lines, idx)
    blob = blob.sub(/\A\s*check_command:?\s*/, "")
    cmd =
      if blob =~ /\A([a-z_]\w*)\s*,?\s*\z/ # bare identifier -> variable
        resolve_var(Regexp.last_match(1), lines) || ""
      else
        quoted_concat(blob)
      end
    next if cmd.empty?
    next unless profile_of(cmd) == :bare
    add(violations, file, idx + 1,
        "fully-BARE auth gate check_command (no --profile/AWS_PROFILE). " \
        "require_external_auth profile auto-discovery is TTY-only, so a bare gate " \
        "is non-deterministic on the unattended (non-TTY) fleet — it falls through " \
        "to whatever ambient profile exists (the cognee/memory/hydra silent " \
        ".env-skip class). Pin an explicit --profile (fleet cookbook), or add this " \
        "file to bin/lint-cookbooks BARE_OK if it is a darwin-only auto-discovery " \
        "cookbook.")
    flagged = true
  end
end

# --- check 6: claude-code deploy-list drift --------------------------------
#
# cookbooks/claude-code/default.rb deploys rules/docs/workflows/agents via
# EXPLICIT %w(...) lists, not Dir.glob. A file dropped into files/<dir>/ is
# NOT deployed until its name is added to the matching list — the silent
# orphan class (debugging-detail.md / mcp-deployment.md / release-plz.md sat
# undeployed for weeks, breaking the "load on demand via Read" pointers in
# debugging.md / infrastructure.md). This check flags any file present on
# disk under files/{rules,docs,workflows,agents}/ but absent from the
# corresponding deploy array.
cc_default = "cookbooks/claude-code/default.rb"
if File.file?(cc_default)
  cc_src = File.read(cc_default)
  # Tie each %w(...) list DIRECTLY to the files/<dir>/ it sources, by matching
  # the fixed 3-line block shape (%w line, remote_file line, source line). This
  # avoids a greedy match grabbing an earlier unrelated %w (e.g. the hooks list).
  # Flat per-file deploy dirs only; skills/ is directory-based + templated.
  wanted = %w[rules docs workflows agents].to_set
  deployed = Hash.new { |h, k| h[k] = [] }
  cc_src.scan(
    /%w\(([^)]*)\)\.each do \|file_name\|\s*\n\s*remote_file[^\n]*\n\s*source "files\/(\w+)\/\#\{file_name\}"/,
  ) do |names, dir|
    deployed[dir] = names.split if wanted.include?(dir)
  end
  wanted.each do |dir|
    listed = deployed[dir]
    disk = Dir["cookbooks/claude-code/files/#{dir}/*"]
             .select { |p| File.file?(p) }
             .map { |p| File.basename(p) }
             .sort
    (disk - listed).each do |missing|
      idx = cc_src.index("files/#{dir}/\#{file_name}") || 0
      lineno = cc_src[0...idx].count("\n") + 1
      add(violations, cc_default, lineno,
          "files/#{dir}/#{missing} exists but is NOT in the #{dir} deploy " \
          "%w() list — it will never reach ~/.claude/#{dir}/. Add it to the " \
          "list, or delete the orphan file. (Explicit-list deploy, not glob: " \
          "dropping a file in files/#{dir}/ does not wire it.)")
    end
  end

  # skills/ is directory-based rather than flat, so the loop above cannot cover
  # it: the skill-name loop ships exactly <name>/SKILL.md, and every other asset
  # needs its own remote_file. That makes it the SAME silent-orphan class —
  # todo-collect/remind_sync.rb was referenced by its own SKILL.md Step 6 and
  # never deployed, so the Reminders sync failed on every host. Walk the tree
  # and match each file against every `source "files/skills/..."` in the recipe.
  #
  # Exempt: test-only trees that deliberately stay repo-side. Keep in sync with
  # the "intentionally excluded" comments in claude-code/default.rb.
  skills_exempt = [
    %r{\Awriting/references/fixtures/}, # Japanese AI-slop corpus, test data
    %r{(\A|/)test_[^/]+\.rb\z},         # unit tests live beside their source
  ]
  skills_root = "cookbooks/claude-code/files/skills"
  if File.directory?(skills_root)
    shipped = Set.new
    # (a) the per-skill loop deploys one SKILL.md per named skill
    if (skill_list = cc_src[/%w\(([^)]*)\)\.each do \|skill_name\|/, 1])
      skill_list.split.each { |s| shipped << "#{s}/SKILL.md" }
    end
    # (b) %w() lists whose source is files/skills/<prefix>/#{file_name}
    cc_src.scan(
      /%w\(([^)]*)\)\.each do \|file_name\|\s*\n\s*remote_file[^\n]*\n\s*source "files\/skills\/([^"]*)\/\#\{file_name\}"/,
    ) { |names, prefix| names.split.each { |n| shipped << "#{prefix}/#{n}" } }
    # (c) single-file remote_file blocks (literal path, no interpolation)
    cc_src.scan(/source "files\/skills\/([^"\#]+)"/) { |(path)| shipped << path }

    Dir.glob("#{skills_root}/**/*")
       .select { |p| File.file?(p) }
       .map { |p| p.sub("#{skills_root}/", "") }
       .sort
       .each do |rel|
      next if shipped.include?(rel)
      next if skills_exempt.any? { |re| rel.match?(re) }

      idx = cc_src.index('source "files/skills/') || 0
      lineno = cc_src[0...idx].count("\n") + 1
      add(violations, cc_default, lineno,
          "files/skills/#{rel} exists but no `source \"files/skills/...\"` in " \
          "the recipe deploys it — it will never reach ~/.claude/skills/. The " \
          "skill loop ships only SKILL.md, so a helper script or template needs " \
          "its own remote_file. Add one, delete the orphan, or (test-only) " \
          "exempt it in this check's skills_exempt.")
    end
  end
end

# --- check 7: `owner` without `group` --------------------------------------
#
# A file/directory resource that sets `owner` and leaves `group` nil makes
# mitamae chown to the group it reads off the existing path. On a host whose
# login user is NSS-virtual (GCE OS Login's libnss_oslogin, sssd, LDAP/NIS) that
# lookup yields nothing, so the resource runs the literal
# `chown <user>:UNKNOWN` and fails -- and with no ignore_failure that aborts the
# rest of the run. node[:setup][:group] is correct on every platform (staff on
# darwin, `id -gn` elsewhere), so naming it is a no-op where the inference was
# already working.
#
# Deliberately tests the JOINED resource body, not `group` at a specific
# indentation: #788 inserted 30 of its 33 `group` lines at column 0, so an
# indent-strict child filter reports 30 false positives across edge-agent,
# macos-hub, obsidian_file_sync, lxc-roon-mcp, gpg-backup and pm2.
recipe_files.each do |file|
  lines = File.readlines(file)
  i = 0
  while i < lines.length
    line = lines[i]
    if line =~ /\A(\s*)(directory|file|template|remote_file)\b.*\bdo\b/
      indent = Regexp.last_match(1).length
      resource = Regexp.last_match(2)
      block = [line]
      start = i
      j = i + 1
      while j < lines.length
        block << lines[j]
        break if lines[j] =~ /\A {#{indent}}end\b/ || lines[j] =~ /\A\t*end\b/ && lines[j][/\A */].length == indent
        j += 1
      end
      body = block.join
      if body =~ /^\s*owner\s+\S/ && body !~ /^\s*group\s+\S/
        add(violations, file, start + 1,
            "`#{resource}` sets `owner` with no `group` — mitamae then chowns to " \
            "the group it reads off the path, which is unreadable for an " \
            "NSS-virtual login user (GCE OS Login), so it emits the literal " \
            "`chown <user>:UNKNOWN` and the resource fails. Add " \
            "`group node[:setup][:group]`.")
      end
      i = j + 1
      next
    end
    i += 1
  end
end

# --- check 8: mruby-absent CRuby methods in recipe Ruby --------------------
#
# mitamae runs mruby. `ruby -c` and the syntax-check job run CRuby, which has
# all of these, so the gap only surfaces at converge — and the dry-run jobs
# catch it ONLY where they actually execute the line, which is why
# Regexp.last_match(1) shipped behind require_external_auth's non-TTY return
# (~/.claude/rules/ruby.md "mruby API constraints").
#
# `dig` is intentionally absent from this set: recipe Ruby has ~35 legitimate
# `node.dig(...)` calls that converge fine on mitamae's node object.
MRUBY_ABSENT = [
  [/\bFile\.(mtime|stat|size|birthtime|ctime|atime)\b/, "File.%s is CRuby-only (mruby's File is a strict subset) — express time/age/size logic as a shell guard string instead"],
  [/\bRegexp\.last_match\s*\(/, "Regexp.last_match takes NO arguments on mruby — the arity form raises ArgumentError at converge; read the capture through $1 / $2"],
  [/\.zero\?/, "Integer#zero? is absent on mruby — write `== 0` (this codebase's existing idiom)"],
  [/\.filter_map\b/, "Enumerable#filter_map is CRuby-only — use .map { }.compact"],
  [/\.each_with_object\b/, "Enumerable#each_with_object is CRuby-only — use .each with an explicit accumulator"],
].freeze

recipe_files.each do |file|
  File.foreach(file).with_index(1) do |raw, lineno|
    next if raw =~ /\A\s*#/
    MRUBY_ABSENT.each do |pattern, message|
      next unless raw =~ pattern
      # sub, not `%`: rules/ruby.md bans building strings with Ruby's `%` where
      # the template may carry its own percent signs.
      detail = message.sub("%s", Regexp.last_match(1).to_s)
      add(violations, file, lineno,
          "#{detail}. Recipe Ruby runs on mruby; `ruby -c` and syntax-check " \
          "cannot see this, and a dry-run only catches it if it EXECUTES the line.")
    end
  end
end

# --- shared: the FLEET identity table --------------------------------------
#
# cookbooks/host-profile/default.rb's `fleet` hash is the offline mirror of the
# identity subset of the canonical registry (home-monitor contracts/devices.json
# -> SSM /host-registry/devices), and checks 9 + 10 both key off it. Parsed by
# brace depth rather than by a terminator line, because entries carry inline
# `{ ... }` values and a reformat must not silently truncate the table.

HOST_PROFILE     = "cookbooks/host-profile/default.rb"
HOSTS_JSON       = "cookbooks/auto-mitamae-orchestrator/files/hosts.json"
EDGE_AGENT_FILES = "cookbooks/edge-agent/files"

def parse_fleet(path)
  return {} unless File.file?(path)

  lines = File.readlines(path).map(&:chomp)
  start = lines.index { |l| l =~ /\A\s*fleet\s*=\s*\{/ }
  return {} unless start

  entries = {}
  depth = 0
  idx = start
  while idx < lines.length
    line = lines[idx]
    unless line =~ /\A\s*#/
      depth += line.count("{") - line.count("}")
      entries[Regexp.last_match(1)] = { line: idx + 1, src: line } if
        idx > start && line =~ /\A\s*"([^"]+)"\s*=>/
    end
    break if depth <= 0 && idx > start
    idx += 1
  end
  entries
end

FLEET = parse_fleet(HOST_PROFILE)

# edge-agent targets the bare-metal / laptop fleet only. sh1-cloud is guarded
# out of linux.rb, and the ES LXCs ship their logs through lxc_entry's
# elastic-agent tags instead.
def edge_agent_exempt?(label)
  label == "sh1-cloud" || label =~ /\Aes-\d\z/
end

# --- check 9: FLEET <-> edge-agent config consistency -----------------------

if FLEET.empty?
  add(violations, HOST_PROFILE, 1,
      "could not parse the `fleet = {` table — checks 9 and 10 degrade to " \
      "silent no-ops without it. Keep the literal `fleet = {` opener, or teach " \
      "parse_fleet in bin/lint-cookbooks the new shape.")
else
  FLEET.each do |label, meta|
    next if edge_agent_exempt?(label)
    next if File.file?("#{EDGE_AGENT_FILES}/config-#{label}.toml")

    add(violations, HOST_PROFILE, meta[:line],
        "FLEET label #{label.inspect} has no #{EDGE_AGENT_FILES}/config-#{label}.toml. " \
        "edge-agent selects its config by node[:profile][:label], so this host " \
        "converges with no agent config at all. Add the config, or exempt the " \
        "label in bin/lint-cookbooks edge_agent_exempt? with the reason.")
  end

  Dir["#{EDGE_AGENT_FILES}/config-*.toml"].sort.each do |path|
    label = File.basename(path, ".toml").sub(/\Aconfig-/, "")
    next if FLEET.key?(label)

    add(violations, path, 1,
        "no #{label.inspect} entry in the host-profile FLEET table, so no host " \
        "ever resolves this label — the file is dead but reads as coverage. Add " \
        "the FLEET entry, or delete the config.")
  end
end

# --- check 10: hosts.json <-> pve/*.rb <-> FLEET consistency [WARN] ---------
#
# The auto-mitamae orchestrator converges exactly the hosts listed in
# hosts.json, so drift here is invisible: a pve/lxc-*.rb missing from the list
# is a CT that never auto-applies (it looks managed because its recipe exists),
# and a role path pointing at a deleted recipe fails only at push time.

PVE_HOSTS_EXEMPT = %w[
  pve/lxc-apm-server.rb
].to_set

if !File.file?(HOSTS_JSON)
  add(warnings, HOSTS_JSON, 1,
      "missing — the auto-mitamae orchestrator has no fleet to converge.")
else
  hosts_lines = File.readlines(HOSTS_JSON).map(&:chomp)
  hosts =
    begin
      JSON.parse(File.read(HOSTS_JSON))
    rescue JSON::ParserError => e
      add(warnings, HOSTS_JSON, 1,
          "unparseable JSON (#{e.message}) — the orchestrator reads this file " \
          "verbatim, so it converges nothing.")
      nil
    end

  if hosts
    line_of = lambda do |needle|
      hit = hosts_lines.index { |l| l.include?(needle) }
      hit ? hit + 1 : 1
    end

    # (i) every declared role recipe must exist
    hosts.each do |entry|
      role = entry["role"].to_s
      next if role.empty? || File.file?(role)

      add(warnings, HOSTS_JSON, line_of.call(role),
          "role #{role.inspect} (label #{entry["label"].inspect}) does not exist " \
          "in the repo — mitamae-runner fails on this host every cycle.")
    end

    # (ii) every LXC recipe must be in the orchestrator's fleet
    declared = hosts.map { |h| h["role"] }.compact.to_set
    Dir["pve/lxc-*.rb"].sort.each do |recipe|
      next if PVE_HOSTS_EXEMPT.include?(recipe) || declared.include?(recipe)

      add(warnings, recipe, 1,
          "no #{HOSTS_JSON} entry — this CT is never auto-converged, so cookbook " \
          "changes reach it only on a manual apply. Add an entry, or list the " \
          "recipe in bin/lint-cookbooks PVE_HOSTS_EXEMPT with the opt-out reason.")
    end

    # (iii) the ES transport IPs live in two hand-maintained copies
    by_label = {}
    hosts.each { |h| by_label[h["label"]] = h }
    %w[es-0 es-1 es-2].each do |label|
      meta = FLEET[label]
      next unless meta

      fleet_ip = meta[:src][/"ip"\s*=>\s*"([^"]+)"/, 1]
      json_ip  = by_label[label] && by_label[label]["host"]
      next if fleet_ip && json_ip && fleet_ip == json_ip

      add(warnings, HOST_PROFILE, meta[:line],
          "FLEET #{label} ip=#{fleet_ip.inspect} disagrees with #{HOSTS_JSON} " \
          "host=#{json_ip.inspect}. The ES node publishes the FLEET value as its " \
          "transport_host while the orchestrator SSHes to the hosts.json one, so " \
          "a split sends the cluster and its converger to different addresses.")
    end
  end
end

# --- check 11: `case node[:platform]` without else [WARN] ------------------
#
# A platform case with no else arm returns nil on an unrecognised platform, so
# the recipe converges "successfully" with an unset path or package name instead
# of failing where the gap is visible.

# Block openers, anchored at the start of an expression (optionally after
# `x = ` / `key: `) so postfix modifiers (`package "x" if darwin`) and `elsif`
# are not counted.
BLOCK_OPENER = /\A\s*(?:[@$]?[A-Za-z_]\w*[?!]?\s*[:=]\s*)?(if|unless|case|while|until|begin|for|def|class|module)\b/
DO_BLOCK     = /\bdo\b(\s*\|[^|]*\|)?\s*(#.*)?\z/
BLOCK_END    = /\A\s*end\b/

# Heredoc bodies carry foreign syntax — an add_profile block's shell `if ... fi`
# would open a block the walk never closes — so mask them before walking.
def heredoc_lines(lines)
  masked = Set.new
  terminator = nil
  lines.each_with_index do |line, idx|
    if terminator
      masked << idx
      terminator = nil if line.strip == terminator
      next
    end
    next if line =~ /\A\s*#/
    m = line.match(/<<[-~]?(['"]?)([A-Z_]{2,})\1/)
    terminator = m[2] if m
  end
  masked
end

def block_delta(line)
  delta = 0
  keyword = line[BLOCK_OPENER, 1]
  if keyword
    delta += 1
    # `while x do` / `for x in y do` open ONE block, not two.
    delta += 1 if line =~ DO_BLOCK && !%w[while until for].include?(keyword)
  elsif line =~ DO_BLOCK
    delta += 1
  end
  delta -= 1 if line =~ BLOCK_END
  delta
end

recipe_files.each do |file|
  lines  = File.readlines(file).map(&:chomp)
  masked = heredoc_lines(lines)

  lines.each_with_index do |line, idx|
    next if masked.include?(idx) || line =~ /\A\s*#/
    next unless line =~ /\bcase\s+node\[:platform\]/

    depth = 1 # the `case` itself
    has_else = false
    j = idx + 1
    while j < lines.length && depth > 0
      l = lines[j]
      unless masked.include?(j) || l =~ /\A\s*#/
        has_else = true if depth == 1 && l =~ /\A\s*else\b/
        depth += block_delta(l)
      end
      j += 1
    end

    if depth > 0
      add(warnings, file, idx + 1,
          "bin/lint-cookbooks could not balance this `case node[:platform]` to " \
          "its `end` (hit EOF at depth #{depth}), so the else-arm check was " \
          "inconclusive here. Fix block_delta rather than trusting the silence.")
      next
    end
    next if has_else

    add(warnings, file, idx + 1,
        "`case node[:platform]` without else — returns nil on an unknown " \
        "platform; add `else raise`.")
  end
end

# --- check 12: node[:platform] inside cookbooks/ (migration ratchet) --------

# The two files that legitimately own platform dispatch.
PLATFORM_ALLOW = %w[
  cookbooks/functions/default.rb
  cookbooks/host-profile/default.rb
].freeze

# Pre-migration burn-down list, generated mechanically (files under cookbooks/
# with a non-comment node[:platform] reference) when the ratchet landed. Files
# here may keep their references until their stream-B migration PR; that PR
# must remove the entry (the ratchet FAILS on a clean file still listed).
# Everything NOT listed is held at zero references from day one.
PLATFORM_PENDING = %w[
  cookbooks/arp-flux/default.rb
  cookbooks/auto-mitamae-orchestrator/default.rb
  cookbooks/awscli/default.rb
  cookbooks/build-essential/default.rb
  cookbooks/ctags/default.rb
  cookbooks/dot-config-nvim/default.rb
  cookbooks/edge-agent/default.rb
  cookbooks/elastic-agent/default.rb
  cookbooks/envchain/default.rb
  cookbooks/eternal-terminal/default.rb
  cookbooks/fastfetch/default.rb
  cookbooks/fd/default.rb
  cookbooks/fonts/default.rb
  cookbooks/fzf/default.rb
  cookbooks/gcloud-cli/default.rb
  cookbooks/gdbm/default.rb
  cookbooks/git/default.rb
  cookbooks/gnupg/default.rb
  cookbooks/golang/default.rb
  cookbooks/gpg-backup/default.rb
  cookbooks/haskell/default.rb
  cookbooks/herdr/default.rb
  cookbooks/jdk/default.rb
  cookbooks/jq/default.rb
  cookbooks/lazygit/default.rb
  cookbooks/libffi/default.rb
  cookbooks/lxc-apm-server/default.rb
  cookbooks/lxc-dev-workstation/default.rb
  cookbooks/lxc-elasticsearch/default.rb
  cookbooks/lxc-es-memory/default.rb
  cookbooks/lxc-homebridge/default.rb
  cookbooks/lxc-hydra/default.rb
  cookbooks/lxc-kibana/default.rb
  cookbooks/lxc-monitoring/default.rb
  cookbooks/lxc-roon-mcp/default.rb
  cookbooks/lxc-roon/default.rb
  cookbooks/lxc-samba/default.rb
  cookbooks/lxc-shared-user/default.rb
  cookbooks/lxc-systemd-hardening-fix/default.rb
  cookbooks/mcp-probe/default.rb
  cookbooks/mcp/default.rb
  cookbooks/mosh/default.rb
  cookbooks/ncurses/default.rb
  cookbooks/neovim/default.rb
  cookbooks/obsidian_file_sync/default.rb
  cookbooks/ollama/default.rb
  cookbooks/pm2/default.rb
  cookbooks/pve-host/default.rb
  cookbooks/python/default.rb
  cookbooks/rbenv/default.rb
  cookbooks/rclone/default.rb
  cookbooks/roon/default.rb
  cookbooks/s3-backup/default.rb
  cookbooks/self-heal-loops/default.rb
  cookbooks/self-heal-observer/default.rb
  cookbooks/speedtest-cli/default.rb
  cookbooks/ssh/default.rb
  cookbooks/starship/default.rb
  cookbooks/tailscale/default.rb
  cookbooks/terraform/default.rb
  cookbooks/unbound-watchdog/default.rb
  cookbooks/unbound/default.rb
  cookbooks/yq/default.rb
  cookbooks/zk/default.rb
  cookbooks/zlib/default.rb
  cookbooks/zsh/default.rb
].freeze

recipe_files.each do |file|
  next unless file.start_with?("cookbooks/")
  next if PLATFORM_ALLOW.include?(file)

  hits = []
  File.foreach(file).with_index(1) do |raw, ln|
    next if raw =~ /\A\s*#/
    hits << ln if raw =~ /node\[:platform\]/
  end

  if PLATFORM_PENDING.include?(file)
    if hits.empty?
      add(violations, file, 1,
          "migrated off node[:platform] but still listed in PLATFORM_PENDING — " \
          "remove its entry from bin/lint-cookbooks in this PR (check 12 ratchet)")
    end
  else
    hits.each do |ln|
      add(violations, file, ln,
          "node[:platform] in a cookbook — branch at the entry/role layer " \
          "(per-OS recipe via include_platform_cookbook or a static ::darwin/" \
          "::linux include), or use install_package / platform_value / " \
          "node[:hw] facts (check 12)")
    end
  end
end

# --- check 13: existence-only auth-gate skip_if (ratchet) ------------------
#
# A `skip_if:` that only asks "does the file exist?" makes the gate permanently
# skip on every host that already converged — so a NEW key added to the
# generator, or a half-written/error-text artifact, never triggers a re-fetch
# (~/.claude/rules/ruby.md "SSM-sourced .env generator: file-existence skip_if
# drops new KEY=VALUE lines silently"). The predicate must inspect CONTENT.
#
# Content-aware forms accepted (any one clears the lambda):
#   file_has_all?  — the mruby-safe helper in cookbooks/functions
#   File.read      — hand-rolled include? check
#   run_command / system — content probe delegated to a shell (`grep -q ...`),
#                    the right form when the file is root-only-readable and
#                    mitamae runs as a non-root user
#
# NEGATED existence (`!File.exist?(script)`) is exempt: that is a "prerequisite
# not deployed yet" precondition, not a "work already done" claim.
#
# Scope: only `require_external_auth(...)` argument regions — deploy_with_ssm_env
# callers never write skip_if (the helper supplies a content-aware one from
# :expected_keys, which is why migrating to it also clears this check).
SKIPIF_PENDING = %w[
  cookbooks/edge-agent/default.rb
  cookbooks/lxc-es-memory/default.rb
  cookbooks/lxc-kibana/default.rb
  cookbooks/lxc-roon-mcp/default.rb
  cookbooks/lxc-weave/default.rb
].to_set

CONTENT_AWARE = /file_has_all\?|File\.read|run_command|\bsystem\(/

recipe_files.each do |file|
  text = File.read(file)
  next unless text.include?("require_external_auth")
  lines = text.lines.map(&:chomp)

  hits = []
  i = 0
  while i < lines.length
    line = lines[i]
    unless line !~ /\A\s*#/ && line =~ /\brequire_external_auth\s*\(/
      i += 1
      next
    end

    # Walk paren depth to the matching close (same approach as check 3).
    depth = 0
    started = false
    j = i
    region = []
    region_start = i
    while j < lines.length
      l = lines[j]
      region << l
      l.each_char do |c|
        if c == "("
          depth += 1; started = true
        elsif c == ")"
          depth -= 1
        end
      end
      break if started && depth <= 0
      j += 1
    end

    # Capture the skip_if lambda body by brace depth (handles `-> { ... }`,
    # `lambda { ... }`, single-line and multi-line).
    si = region.index { |l| l =~ /\A\s*skip_if:/ }
    if si
      bdepth = 0
      bstarted = false
      k = si
      body = []
      while k < region.length
        l = region[k]
        body << l
        l.each_char do |c|
          if c == "{"
            bdepth += 1; bstarted = true
          elsif c == "}"
            bdepth -= 1
          end
        end
        break if bstarted && bdepth <= 0
        k += 1
      end
      blob = body.join("\n")
      # Drop negated existence tests before asking whether any remain.
      positive = blob.gsub(/!\s*File\.exist\?/, "")
      if positive =~ /File\.exist\?/ && blob !~ CONTENT_AWARE
        hits << region_start + si + 1
      end
    end

    i = j + 1
  end

  if SKIPIF_PENDING.include?(file)
    if hits.empty?
      add(violations, file, 1,
          "migrated to a content-aware skip_if but still listed in " \
          "SKIPIF_PENDING — remove its entry from bin/lint-cookbooks in this " \
          "PR (check 13 ratchet)")
    end
  else
    hits.each do |ln|
      add(violations, file, ln,
          "existence-only `skip_if` on an auth gate — a new generator key (or " \
          "a truncated artifact) never re-fetches on an already-converged " \
          "host. Use file_has_all?(path, %w[KEY= ...]), a File.read/include? " \
          "check, a run_command/system content probe, or migrate the flow to " \
          "deploy_with_ssm_env with :expected_keys (check 13)")
    end
  end
end

# --- report ----------------------------------------------------------------

puts "cookbook lint (#{recipe_files.size} recipes scanned)"
$stdout.flush # findings go to stderr; keep the two streams readable when merged

unless warnings.empty?
  warn ""
  warn "WARN: #{warnings.size} warning(s) (advisory — exit code unaffected):"
  warnings.sort.each { |w| warn "  #{w}" }
end

if violations.empty?
  puts "OK: no violations."
  exit 0
else
  warn ""
  warn "FAIL: #{violations.size} violation(s):"
  violations.sort.each { |v| warn "  #{v}" }
  exit 1
end
