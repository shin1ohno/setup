#!/usr/bin/env ruby
# frozen_string_literal: true

# Evaluate resource declarations; only the read-only policy generator may run.
require "digest"
require "json"
require "open3"
require "shellwords"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
COOKBOOK = File.join(ROOT, "cookbooks/claude-code")

class Resource
  attr_reader :attributes
  def initialize(context)
    @context = context
    @attributes = {}
  end

  def node
    @context.node
  end

  def method_missing(name, *args, &block)
    @attributes[name.to_s] = block ? "guard-block" : args
  end

  def respond_to_missing?(*_args)
    true
  end
end

class Graph
  attr_reader :rows
  def initialize(home)
    @home = home
    @rows = []
    @node = {setup: {home: home, root: "#{home}/.setup_shin1ohno",
                     user: "fixture-user", group: "fixture-group"}}
  end

  def node
    @node
  end

  def run_command(command)
    generator = File.join(ROOT, "cookbooks/codex-cli/files/generate_config.sh")
    expected = ["env", "-u", "CODEX_CONFIG_PREAMBLE", "HOME=#{@home}",
                "bash", generator, "--permission-policy"]
    raise ArgumentError, "unexpected graph command" unless Shellwords.split(command) == expected

    # Execute fixed argv, never the supplied shell text. Use only the fixture
    # home and omit an ambient preamble override, just as the recipe does.
    output, status = Open3.capture2({"HOME" => @home, "CODEX_CONFIG_PREAMBLE" => nil},
                                   "bash", generator, "--permission-policy")
    raise "permission generator failed" unless status.success?

    Struct.new(:stdout).new(output)
  end

  def evaluate(text, path)
    previous = @path
    @path = path
    instance_eval(text, path, 1)
  ensure
    @path = previous
  end

  def include_recipe(path)
    path = File.expand_path(path, File.dirname(@path))
    evaluate(File.read(path), path)
  end

  def include_platform_cookbook(name)
    @rows << ["platform-cookbook", name, {}]
  end

  def agents_skill_link(name)
    @rows << ["agents-skill-link", name, {}]
  end

  %i[directory file remote_file execute link].each do |kind|
    define_method(kind) do |name, &block|
      resource = Resource.new(self)
      resource.instance_eval(&block)
      @rows << [kind.to_s, name, resource.attributes]
    end
  end

  def normalized
    @rows.map { |row| JSON.generate(row).gsub(@home, "[HOME]") }.sort
  end
end

Dir.mktmpdir("distribution-graph-") do |home|
  old = Graph.new(home)
  old.evaluate(File.read(File.join(COOKBOOK, "testdata/default-before-distribution-split.rb")),
               File.join(COOKBOOK, "default.rb"))
  current = Graph.new(home)
  current.evaluate(File.read(File.join(COOKBOOK, "default.rb")), File.join(COOKBOOK, "default.rb"))

  # default.rb has included worker-profiles.rb since the pro-dev canary
  # (docs/runbook/worker-instruction-profiles.md). Its resources are the only
  # addition allowed on top of the pre-split fixture, and they are pinned here
  # one by one so the include cannot smuggle anything else in.
  profiles_path = File.join(COOKBOOK, "worker-profiles.rb")
  profiles = Graph.new(home)
  profiles.evaluate(File.read(profiles_path), profiles_path)
  refused = false
  begin
    profiles.run_command("echo unexpected-command")
  rescue ArgumentError
    refused = true
  end
  raise "graph must refuse unrelated commands" unless refused
  expected_profile_resources = %w[.agents .agents/profiles .claude .claude/agents .agents/codex-homes]
    .map { |dir| ["directory", "#{home}/#{dir}"] }
  %w[common dev cos writing].each do |profile|
    codex_home = "#{home}/.agents/codex-homes/#{profile}"
    expected_profile_resources += [
      ["file", "#{home}/.agents/profiles/#{profile}.claude.md"],
      ["file", "#{home}/.agents/profiles/#{profile}.codex.md"],
      ["file", "#{home}/.claude/agents/profile-#{profile}.md"],
      ["directory", codex_home],
      ["file", "#{codex_home}/AGENTS.md"],
      ["file", "#{codex_home}/config.toml"],
      ["link", "#{codex_home}/auth.json"],
    ]
  end
  actual_profile_resources = profiles.rows.map { |kind, name, _| [kind, name] }
  raise "worker-profile resources changed: #{actual_profile_resources.sort - expected_profile_resources.sort} / " \
        "#{expected_profile_resources.sort - actual_profile_resources.sort}" unless
    actual_profile_resources.sort == expected_profile_resources.sort
  auth_links = profiles.rows.select { |kind, _, _| kind == "link" }
  raise "auth.json must link to the shared ~/.codex/auth.json" unless
    auth_links.all? { |_, _, attributes| attributes["to"] == ["#{home}/.codex/auth.json"] }

  # Multiset check: the local graph is exactly every pre-split resource plus
  # the worker-profile resources, so nothing pre-existing was dropped or changed.
  expected = (old.rows + profiles.rows).map { |row| JSON.generate(row).gsub(home, "[HOME]") }.sort
  raise "local resource graph changed" unless expected == current.normalized

  cloud = Graph.new(home)
  %w[instructions skills agents].each do |name|
    path = File.join(COOKBOOK, "#{name}.rb")
    cloud.evaluate(File.read(path), path)
  end
  cloud.rows.each do |kind, name, _attributes|
    raise "non-distribution resource: #{kind} #{name}" unless
      kind == "agents-skill-link" ||
      (%w[directory remote_file file].include?(kind) && name.start_with?("#{home}/.claude", "#{home}/.agents"))
    raise "hooks/settings leaked into cloud" if name.include?("/hooks") || name.end_with?("settings.json", "sources.yaml")
  end
  raise "cloud missed agent definitions" unless cloud.rows.any? { |_, name, _| name.include?("/.claude/agents/") }
  raise "cloud missed shared skill" unless cloud.rows.any? { |_, name, _| name.include?("chief-of-staff/SKILL.md") }
  [current, cloud].each do |graph|
    %w[references/linear.md references/supervision-handoff.md scripts/takeover.py].each do |file|
      raise "chief-of-staff #{file} missing" unless graph.rows.any? { |kind, name, attributes|
        kind == "remote_file" && name.end_with?("chief-of-staff/#{file}") &&
          attributes["source"] == ["files/skills/chief-of-staff/#{file}"]
      }
    end
  end
  puts "Local resource declarations match the pre-split fixture (including every hook) plus the #{profiles.rows.size} worker-profile resources."
  puts "Cloud declares only instruction, skill and agent distribution."
end
