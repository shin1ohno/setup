#!/usr/bin/env python3
"""First-call usage and skill-listing regressions."""
import json
from pathlib import Path
import runpy
import subprocess
import tempfile
import unittest

BIN = Path(__file__).resolve().parent
USAGE = runpy.run_path(str(BIN / "instruction-usage"))


class UsageTest(unittest.TestCase):
    def test_first_call_usage_does_not_add_codex_cached_tokens_twice(self):
        event = dict(type="turn.completed", usage=dict(input_tokens=100, cached_input_tokens=80, output_tokens=5))
        usage = USAGE["first_usage"]([json.dumps(event)], "codex")
        self.assertEqual(usage["context_input_tokens"], 100)
        self.assertIn("may contain multiple model calls", usage["scope"])

    def test_claude_cache_categories_are_added_once_for_the_first_api_call(self):
        event = dict(type="assistant", message=dict(id="same-call", usage=dict(
            input_tokens=20, cache_read_input_tokens=50, cache_creation_input_tokens=30, output_tokens=5)))
        usage = USAGE["first_usage"]([json.dumps(event), json.dumps(event)], "claude")
        self.assertEqual(usage["context_input_tokens"], 100)

    def test_claude_skill_listing_counts_characters_and_name_only_entries(self):
        content = "- writing: 日本語の説明\n- init\n- plugin:skill\n"
        listing = dict(type="attachment", attachment=dict(
            type="skill_listing", content=content, skillCount=3))
        event = dict(type="assistant", message=dict(usage=dict(input_tokens=10, output_tokens=2)))
        usage = USAGE["first_usage"](map(json.dumps, [listing, event]), "claude")
        self.assertEqual(usage["skill_listing"], dict(skills=3, chars=len(content), name_only=2))

    def test_claude_skill_listing_with_all_descriptions(self):
        content = "- plugin:skill: Description\n"
        listing = dict(type="attachment", attachment=dict(
            type="skill_listing", content=content, skillCount=1))
        event = dict(type="assistant", message=dict(usage=dict(input_tokens=10, output_tokens=2)))
        usage = USAGE["first_usage"](map(json.dumps, [listing, event]), "claude")
        self.assertEqual(usage["skill_listing"], dict(skills=1, chars=len(content), name_only=0))

    def test_claude_skill_listing_uses_snapshot_before_first_call(self):
        def listing(content, count):
            return dict(type="attachment", attachment=dict(
                type="skill_listing", content=content, skillCount=count))
        event = dict(type="assistant", message=dict(usage=dict(input_tokens=10, output_tokens=2)))
        events = [listing("- old\n", 1), listing("- a\n- b\n", 2), event,
                  listing("- later\n", 1)]
        usage = USAGE["first_usage"](map(json.dumps, events), "claude")
        self.assertEqual(usage["skill_listing"], dict(skills=2, chars=8, name_only=2))

    def test_codex_help_specifies_exec_stdout_and_rollout_fails(self):
        help_result = subprocess.run([str(BIN / "instruction-usage"), "--help"],
                                     capture_output=True, text=True, check=True)
        self.assertIn("codex exec --json stdout", help_result.stdout)
        self.assertIn("not rollout JSONL", " ".join(help_result.stdout.split()))
        with tempfile.TemporaryDirectory() as tmp:
            file = Path(tmp) / "rollout.jsonl"
            file.write_text(json.dumps(dict(type="event_msg", payload=dict(
                type="token_count", info=dict(total_token_usage=dict(input_tokens=100))))) + "\n")
            result = subprocess.run([str(BIN / "instruction-usage"), "--harness", "codex",
                                     "--file", str(file)], capture_output=True, text=True)
        self.assertEqual(result.returncode, 1)
        self.assertIn("no first-call usage found", json.loads(result.stderr)["error"])


if __name__ == "__main__":
    unittest.main()
