#!/usr/bin/env python3
"""Profile byte, argv, usage and opt-in native prompt-inspection regressions."""
import hashlib
import json
import os
from pathlib import Path
import runpy
import subprocess
import tempfile
import tomllib
import unittest

BIN = Path(__file__).resolve().parent
PROFILE = runpy.run_path(str(BIN / "worker-profile"))
USAGE = runpy.run_path(str(BIN / "instruction-usage"))


class ProfileTest(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)

    def test_byte_guard_checks_exact_artifact_including_multibyte_text(self):
        file = self.root / "AGENTS.md"
        file.write_bytes(b"a" * 32768)
        self.assertEqual(len(PROFILE["checked_bytes"](file, "codex")), 32768)
        for data in [b"a" * 32769, ("語" * 11000).encode()]:
            file.write_bytes(data)
            with self.assertRaises(ValueError):
                PROFILE["checked_bytes"](file, "codex")

    def test_render_guards_the_combination_not_only_each_layer(self):
        for layer in ["common", "dev"]:
            (self.root / f"{layer}.codex.md").write_text("a" * 17000)
        with self.assertRaises(ValueError):
            PROFILE["render"](self.root, "codex", "dev")

    def test_real_profiles_render_without_weakening_the_cap(self):
        for profile in PROFILE["PROFILES"]:
            data = PROFILE["render"](PROFILE["SOURCES"], "codex", profile)
            self.assertLessEqual(len(data), 32768)
            self.assertIn(b"Shared Agent Instructions", data)

    def deploy_fixture(self, profile="dev"):
        """Mirror what worker-profiles.rb deploys, under the test's own root."""
        profiles = self.root / "profiles"
        homes = self.root / "codex-homes"
        profiles.mkdir(exist_ok=True)
        (homes / profile).mkdir(parents=True, exist_ok=True)
        (profiles / f"{profile}.claude.md").write_bytes(
            PROFILE["render"](PROFILE["SOURCES"], "claude", profile))
        (homes / profile / "AGENTS.md").write_bytes(
            PROFILE["render"](PROFILE["SOURCES"], "codex", profile))
        (homes / profile / "config.toml").write_text(
            'project_doc_max_bytes = 0\ncli_auth_credentials_store = "file"\n')
        return profiles, homes

    def prepare(self, harness, destination, cwd, model, *extra):
        argv = ["python3", str(BIN / "worker-profile"), "prepare", "--harness", harness,
                "--profile", "dev", "--directory", str(destination), "--cwd", str(cwd),
                "--model", model, "--effort", "medium", "--reason", "fixture",
                "--profiles-dir", str(self.root / "profiles"),
                "--codex-homes", str(self.root / "codex-homes"), *extra]
        return subprocess.run(argv, text=True, capture_output=True, timeout=10)

    def codex_catalog(self, model):
        catalog = self.root / "catalog.json"
        catalog.write_text(json.dumps({"models": [{"slug": model,
            "supported_reasoning_levels": [{"effort": "medium"}]}]}))
        return catalog

    def test_codex_prepare_uses_the_fixed_home_and_trusts_only_the_cwd(self):
        _, homes = self.deploy_fixture()
        model = "fixture-model; touch NEVER"
        cwd = self.root / 'repo with "quote".and.dots'
        cwd.mkdir()
        destination = self.root / "worker with spaces"
        result = self.prepare("codex", destination, cwd, model, "--catalog", str(self.codex_catalog(model)))
        self.assertEqual(result.returncode, 0, result.stderr)
        plan = json.loads((destination / "launch-plan.json").read_text())
        home = homes / "dev"
        self.assertEqual(plan["env_set"], {"CODEX_HOME": str(home)})
        self.assertEqual(plan["codex_home"], str(home))
        self.assertEqual(plan["profile_file"], str(home / "AGENTS.md"))
        self.assertIn("codex-homes", plan["env_set"]["CODEX_HOME"])
        self.assertEqual(plan["argv"][:7], ["codex", "--no-daemon", "-C", str(cwd), "-m", model, "-c"])
        pairs = [plan["argv"][i + 1] for i, item in enumerate(plan["argv"]) if item == "-c"]
        self.assertEqual(pairs[:2], ['model_reasoning_effort="medium"', "project_doc_max_bytes=0"])
        trust = [pair for pair in pairs if pair.startswith("projects=")]
        self.assertEqual(len(trust), 1)
        self.assertEqual(tomllib.loads(trust[0])["projects"], {str(cwd): {"trust_level": "trusted"}})
        self.assertEqual(plan["instruction_sha256"],
                         hashlib.sha256((home / "AGENTS.md").read_bytes()).hexdigest())
        for name in ["OPENAI_API_KEY", "CODEX_API_KEY", "CLAUDE_CODE_EFFORT_LEVEL"]:
            self.assertIn(name, plan["env_unset"])
        self.assertFalse(plan["launch_ready"])
        self.assertIsNone(plan["observed_model"])
        # The plan neither creates a per-task home nor touches credentials.
        self.assertEqual(sorted(path.name for path in destination.iterdir()), ["launch-plan.json"])
        self.assertEqual(sorted(path.name for path in home.iterdir()), ["AGENTS.md", "config.toml"])
        self.assertFalse((self.root / "NEVER").exists())
        manifest = json.loads(result.stdout)
        self.assertNotIn("argv", manifest)
        self.assertEqual(manifest["plan_file"], str(destination / "launch-plan.json"))

    def test_codex_prepare_refuses_a_missing_or_stale_home(self):
        catalog = self.codex_catalog("m")
        result = self.prepare("codex", self.root / "w1", self.root, "m", "--catalog", str(catalog))
        self.assertEqual(result.returncode, 1)
        self.assertIn("not deployed", result.stderr)
        self.assertFalse((self.root / "w1").exists())
        _, homes = self.deploy_fixture()
        (homes / "dev/AGENTS.md").write_text("stale profile\n")
        result = self.prepare("codex", self.root / "w2", self.root, "m", "--catalog", str(catalog))
        self.assertEqual(result.returncode, 1)
        self.assertIn("differs", result.stderr)
        self.assertFalse((self.root / "w2").exists())

    def test_claude_prepare_appends_the_deployed_profile_file(self):
        profiles, _ = self.deploy_fixture()
        destination = self.root / "claude"
        result = self.prepare("claude", destination, self.root, "sonnet")
        self.assertEqual(result.returncode, 0, result.stderr)
        plan = json.loads((destination / "launch-plan.json").read_text())
        profile = profiles / "dev.claude.md"
        self.assertEqual(plan["env_set"], {"CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1"})
        self.assertEqual(plan["argv"], ["claude", "--model", "sonnet", "--effort", "medium",
                                        "--append-system-prompt-file", str(profile)])
        self.assertEqual(plan["profile_file"], str(profile))
        self.assertEqual(plan["instruction_sha256"], hashlib.sha256(profile.read_bytes()).hexdigest())
        self.assertIn("CLAUDE_CODE_EFFORT_LEVEL", plan["env_unset"])
        self.assertFalse(plan["launch_ready"])
        self.assertEqual(sorted(path.name for path in destination.iterdir()), ["launch-plan.json"])

    def test_launch_ready_only_for_canaried_harness_route_pairs(self):
        self.deploy_fixture()
        catalog = self.codex_catalog("m")
        # The 2026-11-08 pro-dev canary passed exactly these three pairs.
        expected = {("claude", "hc"): True, ("claude", "agent"): True, ("claude", "herdr1"): False,
                    ("codex", "hc"): True, ("codex", "agent"): False, ("codex", "herdr1"): False,
                    ("claude", None): False, ("codex", None): False}
        for (harness, route), ready in expected.items():
            extra = ["--catalog", str(catalog)] if harness == "codex" else []
            if route:
                extra += ["--route", route]
            destination = self.root / f"plan-{harness}-{route}"
            result = self.prepare(harness, destination, self.root, "m" if harness == "codex" else "sonnet", *extra)
            self.assertEqual(result.returncode, 0, result.stderr)
            plan = json.loads((destination / "launch-plan.json").read_text())
            self.assertIs(plan["launch_ready"], ready, (harness, route))
            self.assertEqual(plan["route"], route)
            self.assertIn("Launch-ready" if ready else "Not launch-ready", plan["note"])
            if not ready:
                self.assertTrue(plan["note"].split(":", 1)[1].strip(), "a false plan says why")
            self.assertEqual(json.loads(result.stdout)["launch_ready"], ready)
        result = self.prepare("claude", self.root / "bad-route", self.root, "sonnet", "--route", "herdr")
        self.assertEqual(result.returncode, 2)
        self.assertFalse((self.root / "bad-route").exists())

    def test_claude_prepare_refuses_a_missing_or_stale_profile(self):
        result = self.prepare("claude", self.root / "c1", self.root, "sonnet")
        self.assertEqual(result.returncode, 1)
        self.assertIn("not deployed", result.stderr)
        profiles, _ = self.deploy_fixture()
        (profiles / "dev.claude.md").write_text("stale profile\n")
        result = self.prepare("claude", self.root / "c2", self.root, "sonnet")
        self.assertEqual(result.returncode, 1)
        self.assertIn("differs", result.stderr)
        self.assertFalse((self.root / "c2").exists())

    def test_trust_override_round_trips_awkward_paths_through_toml(self):
        for path in ['/a/.claude/worktrees/x', '/q"uote', '/back\\slash', '/new\nline',
                     '/del\x7f', '/emoji\U0001F600', '/x=y/{z}', "/tab\there"]:
            value = PROFILE["trust_override"](Path(path))
            self.assertEqual(tomllib.loads(value), {"projects": {path: {"trust_level": "trusted"}}})

    def test_first_call_usage_does_not_add_codex_cached_tokens_twice(self):
        event = dict(type="turn.completed", usage=dict(input_tokens=100, cached_input_tokens=80, output_tokens=5))
        usage = USAGE["first_usage"]([json.dumps(event)], "codex")
        self.assertEqual(usage["context_input_tokens"], 100)
        self.assertIn("may contain multiple model calls", usage["scope"])

    def test_claude_cache_categories_are_added_once_for_the_first_api_call(self):
        event = dict(type="assistant", message=dict(id="same-call", usage=dict(
            input_tokens=20, cache_read_input_tokens=50, cache_creation_input_tokens=30, output_tokens=5)))
        usage = USAGE["first_usage"]([json.dumps(event), json.dumps(event)], "claude")
        self.assertEqual(usage["context_input_tokens"], 100)

    @unittest.skipUnless(os.environ.get("INSTRUCTION_TEST_CODEX"), "explicit native Codex binary required")
    def test_native_prompt_excludes_project_and_keeps_private_profile(self):
        home = self.root / "codex"
        home.mkdir()
        project = self.root / "project"
        project.mkdir()
        (project / ".git").mkdir()
        (home / "AGENTS.md").write_text("GLOBAL_PROFILE_SENTINEL_ONLY\n")
        (home / "config.toml").write_text('cli_auth_credentials_store = "ephemeral"\n')
        (project / "AGENTS.md").write_text("PROJECT_SENTINEL_MUST_BE_EXCLUDED\n")
        env = dict(os.environ, CODEX_HOME=str(home))
        for name in ["OPENAI_API_KEY", "CODEX_API_KEY"]:
            env.pop(name, None)
        for zero in [False, True]:
            argv = [os.environ["INSTRUCTION_TEST_CODEX"], "-C", str(project), "debug", "prompt-input"]
            if zero:
                argv += ["-c", "project_doc_max_bytes=0"]
            result = subprocess.run(argv, env=env, capture_output=True, text=True, timeout=30)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertIn("GLOBAL_PROFILE_SENTINEL_ONLY", result.stdout)
            self.assertEqual("PROJECT_SENTINEL_MUST_BE_EXCLUDED" in result.stdout, not zero)

        data = PROFILE["render"](PROFILE["SOURCES"], "codex", "dev")
        (home / "AGENTS.md").write_bytes(data)
        result = subprocess.run([os.environ["INSTRUCTION_TEST_CODEX"], "-C", str(project),
            "debug", "prompt-input", "-c", "project_doc_max_bytes=0"], env=env,
            capture_output=True, text=True, timeout=30)
        self.assertEqual(result.returncode, 0, result.stderr)
        def texts(value):
            if isinstance(value, str):
                yield value
            elif isinstance(value, dict):
                for item in value.values():
                    yield from texts(item)
            elif isinstance(value, list):
                for item in value:
                    yield from texts(item)
        effective = "\n".join(texts(json.loads(result.stdout)))
        self.assertIn(data.decode("utf-8").strip(), effective)
        self.assertNotIn("PROJECT_SENTINEL_MUST_BE_EXCLUDED", effective)


if __name__ == "__main__":
    unittest.main()
