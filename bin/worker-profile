#!/usr/bin/env python3
"""Render and prepare explicit worker profiles; never dispatch or copy credentials."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
SOURCES = ROOT / "cookbooks/claude-code/files/instructions/generated"
# Deployed by cookbooks/claude-code/worker-profiles.rb.
CLAUDE_PROFILES = Path.home() / ".agents/profiles"
CODEX_HOMES = Path.home() / ".agents/codex-homes"
PROFILES = ("common", "dev", "cos", "writing")
CAP = 32768


def checked_bytes(path, harness):
    data = Path(path).read_bytes()
    data.decode("utf-8")
    if not data.strip():
        raise ValueError("profile must not be empty")
    if harness == "codex" and len(data) > CAP:
        raise ValueError(f"Codex profile exceeds {CAP} bytes: {len(data)}")
    return data


def render(sources, harness, profile):
    layers = ["common"] + ([] if profile == "common" else [profile])
    data = b"\n".join(checked_bytes(sources / f"{layer}.{harness}.md", harness) for layer in layers)
    if harness == "codex" and len(data) > CAP:
        raise ValueError(f"combined Codex profile exceeds {CAP} bytes: {len(data)}")
    return data


def catalog_supports(path, model, effort):
    catalog = json.loads(path.read_text(encoding="utf-8"))
    for item in catalog["models"]:
        if item["slug"] == model:
            if effort in [level["effort"] for level in item["supported_reasoning_levels"]]:
                return
            raise ValueError("effort is not supported by the supplied catalog")
    raise ValueError("model is not in the supplied catalog")


def toml_string(text):
    """Quote text as a TOML basic string (escaping what TOML forbids raw)."""
    out = []
    for char in text:
        if char in '"\\':
            out.append("\\" + char)
        elif ord(char) < 0x20 or ord(char) == 0x7F:
            out.append(f"\\u{ord(char):04x}")
        else:
            out.append(char)
    return '"' + "".join(out) + '"'


def trust_override(cwd):
    # Codex 0.167.0 ignores the dotted form projects."<path>".trust_level=...
    # (the TUI still asks "Trust this folder?"); an inline table is honored and
    # is never written back to config.toml, which the cookbook owns. It replaces
    # any projects table, and the cookbook's config.toml has none.
    return "projects={" + toml_string(str(cwd)) + '={trust_level="trusted"}}'


def deployed(path, expected, what):
    """Read a cookbook-deployed artifact and require it to match the source."""
    try:
        data = path.read_bytes()
    except FileNotFoundError:
        raise ValueError(f"{what} is not deployed at {path}; apply claude-code::worker-profiles") from None
    if data != expected:
        raise ValueError(f"{what} at {path} differs from the rendered profile; re-apply claude-code::worker-profiles")
    return data


def prepare(args):
    data = render(args.sources, args.harness, args.profile)
    if args.model == "default" or not args.model.strip():
        raise ValueError("model must be selected explicitly")
    if args.harness == "codex":
        if args.catalog is None:
            raise ValueError("Codex preparation requires an observed model catalog")
        catalog_supports(args.catalog, args.model, args.effort)
    elif args.effort not in {"low", "medium", "high", "xhigh", "max"}:
        raise ValueError("effort is not listed by the observed Claude CLI help")
    directory = args.directory
    if not directory.is_absolute() or directory.exists() or directory.is_symlink():
        raise ValueError("directory must be a new absolute private directory")
    if not args.cwd.is_absolute() or not args.cwd.is_dir():
        raise ValueError("cwd must be an existing absolute directory")
    env_set = {}
    env_unset = ["CLAUDE_CODE_EFFORT_LEVEL"]
    extra = {}
    if args.harness == "codex":
        # The fixed per-profile home: AGENTS.md is the profile, auth.json links
        # to the shared file store. Only AGENTS.md is read; nothing is written
        # and auth.json is never opened.
        worker_home = args.codex_homes / args.profile
        if not worker_home.is_absolute() or worker_home.is_symlink() or not worker_home.is_dir():
            raise ValueError(f"Codex home is not deployed at {worker_home}; apply claude-code::worker-profiles")
        profile = worker_home / "AGENTS.md"
        deployed(profile, data, "Codex profile")
        env_set["CODEX_HOME"] = str(worker_home)
        env_unset += ["OPENAI_API_KEY", "CODEX_API_KEY"]
        argv = ["codex", "--no-daemon", "-C", str(args.cwd), "-m", args.model,
                "-c", "model_reasoning_effort=" + toml_string(args.effort),
                "-c", "project_doc_max_bytes=0",
                "-c", trust_override(args.cwd)]
        extra["codex_home"] = str(worker_home)
    else:
        profile = args.profiles_dir / f"{args.profile}.claude.md"
        if not profile.is_absolute():
            raise ValueError("Claude profile path must be absolute")
        deployed(profile, data, "Claude profile")
        # Drops memory files, rules and their imports (SH1-69); the profile is
        # appended so the built-in system prompt stays.
        env_set["CLAUDE_CODE_DISABLE_CLAUDE_MDS"] = "1"
        argv = ["claude", "--model", args.model, "--effort", args.effort,
                "--append-system-prompt-file", str(profile)]
    # Flipped only by the canary PR, after the dispatch routes use these plans.
    ready = False
    note = "Not launch-ready until the pro-dev canary observes context, login, model and effort."
    directory.mkdir(mode=0o700)
    plan = dict(harness=args.harness, profile=args.profile, model=args.model,
                effort=args.effort, reason=args.reason, cwd=str(args.cwd), argv=argv, env_set=env_set,
                env_unset=env_unset, profile_file=str(profile), **extra, instruction_bytes=len(data),
                instruction_sha256=hashlib.sha256(data).hexdigest(),
                launch_ready=ready, observed_model=None, observed_effort=None, note=note)
    plan_file = directory / "launch-plan.json"
    plan_file.write_text(json.dumps(plan, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(plan_file, 0o600)
    return {key: value for key, value in plan.items() if key not in {"argv", "env_set", "env_unset"}} | {
        "plan_file": str(plan_file)}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    check = sub.add_parser("check")
    check.add_argument("--file", required=True, type=Path)
    check.add_argument("--harness", choices=("claude", "codex"), required=True)
    build = sub.add_parser("render")
    prep = sub.add_parser("prepare")
    for command in [build, prep]:
        command.add_argument("--sources", type=Path, default=SOURCES)
        command.add_argument("--harness", choices=("claude", "codex"), required=True)
        command.add_argument("--profile", choices=PROFILES, required=True)
    build.add_argument("--output", type=Path, required=True)
    prep.add_argument("--directory", type=Path, required=True)
    prep.add_argument("--cwd", type=Path, required=True)
    prep.add_argument("--reason", required=True)
    prep.add_argument("--model", required=True)
    prep.add_argument("--effort", choices=("low", "medium", "high", "xhigh", "max", "ultra"), required=True)
    prep.add_argument("--catalog", type=Path)
    prep.add_argument("--profiles-dir", type=Path, default=CLAUDE_PROFILES,
                      help="deployed Claude profiles (<profile>.claude.md)")
    prep.add_argument("--codex-homes", type=Path, default=CODEX_HOMES,
                      help="parent of the deployed per-profile CODEX_HOME directories")
    args = parser.parse_args()
    try:
        if args.command == "check":
            data = checked_bytes(args.file, args.harness)
            result = dict(bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
        elif args.command == "render":
            data = render(args.sources, args.harness, args.profile)
            # Exclusive creation prevents overwriting the controller's profile.
            with args.output.open("xb") as stream:
                stream.write(data)
            result = dict(file=str(args.output), bytes=len(data))
        else:
            result = prepare(args)
        print(json.dumps(result))
    except (ValueError, OSError, KeyError, TypeError) as error:
        print(json.dumps({"error": str(error)}), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
