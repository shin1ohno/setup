[Unit]
# Static routes from a LAN host to the AWS VPC and the tailnet CGNAT range,
# next-hopped at the pro-router LXC (192.168.1.60 = home tailnet subnet router).
#
# Why this is needed: the LAN default gateway (RTX1210, 192.168.1.253) carries a
# static route for these CIDRs -> 192.168.1.60 (home-monitor rtx_static_route.aws
# / .tailscale), but the RTX does NOT hairpin-forward to a next-hop that sits on
# the same LAN segment as the source, so traffic sent via the default gateway is
# silently dropped. Hosts must therefore hold the route directly. DHCP clients
# learn 10.33.128.0/18 via DHCP option 121 (home-monitor rtx_dhcp_scope);
# static-IP hosts (PVE LXCs) get both CIDRs from this unit.
#
# 100.64.0.0/10 is NO LONGER distributed by DHCP (dropped 2026-08-25): option 121
# is scope-wide, and handing a tailnet's own address space to every DHCP client
# overrides the utun/tailscale0 route of any client that is itself a node on a
# DIFFERENT tailnet. So for CGNAT this unit is now the only supplier, and by
# design it only ever runs where there is no tailscale0 (see default.rb's guard).
#
# CIDRs/next-hop are fleet constants (see home-monitor contracts/devices.json
# pro-router = .60, var.vpc_cidr = 10.33.128.0/18, var.tailscale_cgnat_cidr =
# 100.64.0.0/10). Update here if those change.
Description=Static routes to AWS VPC + tailnet via pro-router (192.168.1.60)
After=network-online.target
Wants=network-online.target
# Retry budget for Restart= below: 10 attempts over 2 minutes. The defaults
# (5 starts per 10s) are exhausted in ~10s at RestartSec=5s, which is shorter
# than a slow LXC boot and would land right back in the permanent-failure state
# this is meant to prevent. These two directives belong in [Unit], not
# [Service] — they moved there in systemd 229.
StartLimitIntervalSec=120s
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
# network-online.target is NOT sufficient here. In an LXC it is satisfied before
# the veth actually has a usable path to the next hop, so `ip route replace`
# exits 2 ("Network is unreachable" / bad gateway) and, as a Type=oneshot with
# no Restart=, the unit stays failed forever. Nothing retries it and nothing
# alerts on it, so the host silently loses its VPC + tailnet routes until a
# human notices.
#
# Observed 2026-08-29 on CT 103: a provider-issued `vzreboot` (terraform
# updating the container's dns block) brought it back with vpc-route.service
# failed and both routes absent; a manual `systemctl restart` fixed it
# immediately, which is exactly what this retry does automatically. An earlier
# boot of the same container on 2026-08-26 won the race and came up clean, so
# this is intermittent -- the kind of failure that survives spot checks. Every
# fleet CT runs this unit (roles/lxc-core), so a fleet-wide restart would leave
# an unpredictable subset of them unrouted.
#
# on-failure, not always: a genuine misconfiguration (wrong next hop) should
# still end in a visible failed state rather than looping forever.
Restart=on-failure
RestartSec=5s
# `ip route replace` is idempotent — safe to (re)run on every start, which is
# what makes the retry above safe: a retry after a partial success re-applies
# the same route rather than erroring on "file exists".
ExecStart=/usr/sbin/ip route replace 10.33.128.0/18 via 192.168.1.60
ExecStart=/usr/sbin/ip route replace 100.64.0.0/10 via 192.168.1.60
# `-` prefix: tolerate the route already being absent on teardown.
ExecStop=-/usr/sbin/ip route del 10.33.128.0/18 via 192.168.1.60
ExecStop=-/usr/sbin/ip route del 100.64.0.0/10 via 192.168.1.60

[Install]
WantedBy=multi-user.target
