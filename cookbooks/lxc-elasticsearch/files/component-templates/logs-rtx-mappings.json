{
  "_meta": {
    "description": "Mappings for the RTX router syslog data stream (logs-rtx-*), written by cookbooks/lxc-monitoring/files/vector.toml.",
    "strict_mapping_note": "dynamic is strict: a document carrying a field absent from this list is rejected whole with strict_dynamic_mapping_exception. When adding a parser stage to vector.toml that emits new fields, apply this component template FIRST and also PUT logs-rtx-default/_mapping (the component template only reaches indices created after the change, not the current write index).",
    "last_field_addition": "2026-08-23 - ip_version / icmp_type / event_kind / dyn_seq / session_time / sw_path / sw_mac / sw_event, added with the IPv6, [INSPECT] and [SWCTL] parser stages."
  },
  "template": {
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp":     { "type": "date" },
        "data_stream": {
          "properties": {
            "type":      { "type": "constant_keyword" },
            "dataset":   { "type": "constant_keyword" },
            "namespace": { "type": "constant_keyword" }
          }
        },
        "host":           { "type": "keyword" },
        "router":         { "type": "keyword" },
        "filter_no":      { "type": "keyword" },
        "rule":           { "type": "keyword" },
        "action":         { "type": "keyword" },
        "protocol":       { "type": "keyword" },
        "src":            { "type": "ip" },
        "src_port":       { "type": "integer" },
        "dst":            { "type": "ip" },
        "dst_port":       { "type": "integer" },
        "peer":           { "type": "ip" },
        "peer_port":      { "type": "integer" },
        "local":          { "type": "ip" },
        "local_port":     { "type": "integer" },
        "lease_ip":       { "type": "ip" },
        "tag":            { "type": "keyword" },
        "interface":      { "type": "keyword" },
        "direction":      { "type": "keyword" },
        "ike_event":      { "type": "match_only_text" },
        "message":        { "type": "match_only_text" },
        "geoip_country":      { "type": "keyword" },
        "geoip_country_code": { "type": "keyword" },
        "geoip_country_name": { "type": "keyword" },
        "geoip_city":         { "type": "keyword" },
        "geoip_city_name":         { "type": "keyword" },
        "geoip_continent_code":    { "type": "keyword" },
        "geoip_subdivision_code":  { "type": "keyword" },
        "geoip_subdivision_name":  { "type": "keyword" },
        "geoip_latitude":          { "type": "float" },
        "geoip_longitude":         { "type": "float" },
        "geoip_location":     { "type": "geo_point" },
        "severity":           { "type": "keyword" },
        "severity_num":       { "type": "integer" },
        "facility":           { "type": "keyword" },
        "facility_num":       { "type": "integer" },
        "phase":              { "type": "keyword" },
        "dhcp_event":         { "type": "keyword" },
        "mac":                { "type": "keyword" },
        "repeat_count":       { "type": "integer" },
        "port":               { "type": "integer" },
        "source_type":        { "type": "keyword" },
        "ip_version":         { "type": "byte" },
        "icmp_type":          { "type": "keyword" },
        "event_kind":         { "type": "keyword" },
        "dyn_seq":            { "type": "keyword" },
        "session_time":       { "type": "date" },
        "sw_path":            { "type": "keyword" },
        "sw_mac":             { "type": "keyword" },
        "sw_event":           { "type": "keyword" }
      }
    }
  }
}
