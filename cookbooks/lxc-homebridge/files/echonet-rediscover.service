[Unit]
Description=Ask Homebridge's ECHONET Lite plugin to re-probe known device IPs
Documentation=https://github.com/sylpied/homebridge-echonet-lite-plus
After=homebridge.service

[Service]
Type=oneshot
# Deliberately NO RemainAfterExit. The companion timer recurs on
# OnUnitInactiveSec, which needs this unit to actually reach inactive after
# each run; RemainAfterExit=true parks it at active (exited) forever, the
# deactivation reference never arrives, and the timer's next elapse becomes
# infinity — it fires exactly once and never again. Verified on CT 120:
# with RemainAfterExit the timer reported Trigger empty /
# NextElapseUSecMonotonic=infinity after its first fire.
#
# RemainAfterExit is the remedy for the OTHER shape — OnUnitActiveSec on a
# unit whose active window is ~zero. Pick one; combining them breaks both.
ExecStart=/usr/local/bin/echonet-rediscover
