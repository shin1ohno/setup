[Unit]
Description=Periodic ECHONET Lite re-discovery request for Homebridge

[Timer]
# OnBootSec covers a cold boot, OnActiveSec covers `systemctl restart` of the
# timer itself (a cookbook update), and OnUnitInactiveSec drives the recurring
# fire. 30 minutes bounds how long a unit missed at Homebridge startup can stay
# invisible, while keeping the plugin's info-level "再探索" log line to 48 a day.
#
# OnUnitInactiveSec requires the companion service to reach inactive after each
# run — see the RemainAfterExit note in echonet-rediscover.service.
#
# Verifying this timer: every schedule here is MONOTONIC, so the usual
# `--property=Trigger` check reads empty even when the timer is perfectly
# armed — Trigger only carries realtime (OnCalendar) elapses. Check
# `--property=NextElapseUSecMonotonic` instead: a duration means armed,
# `infinity` means it will never fire. `systemctl list-timers` agrees (a NEXT
# column value vs `-`), and both beat is-enabled/is-active, which report
# enabled/active either way.
OnBootSec=120s
OnActiveSec=120s
OnUnitInactiveSec=1800s
Unit=echonet-rediscover.service

[Install]
WantedBy=timers.target
