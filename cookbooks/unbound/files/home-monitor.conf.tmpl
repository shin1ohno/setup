# /etc/unbound/unbound.conf.d/home-monitor.conf
# Managed by mitamae (cookbooks/unbound). DO NOT EDIT BY HAND.
# Rendered from this template by cookbooks/unbound/files/generate-home-local.sh
# (the dedicated marker line further below is replaced with home.local local-data).
#
# LAN DNS resolver for 192.168.1.0/24 and fd97:b085:767d::/64, replacing the
# RTX1210 forwarder which does not serve TCP/53 (RFC 7766 TCP-fallback on
# truncated responses fails there, breaking Linux name resolution on
# large/DNSSEC/long-TXT answers).
#   home.local              -> served LOCALLY from local-data (see marker below),
#                              A and AAAA; unknown names fall through to VPC
#                              Route53 (10.33.128.2)
#   1.168.192.in-addr.arpa  -> VPC Route53 resolver (10.33.128.2)
#   everything else         -> Cloudflare + Quad9 DoT, over v4 and v6
#
# Dual-stack on both sides: it listens on v4 and v6, and it can reach upstreams
# over either. Internal AAAA answers are ULA only — see the access-control and
# local-data blocks for why the delegated global prefix is deliberately absent
# from both.

server:
    interface: 0.0.0.0@53
    # Dual-stack since the LAN gained IPv6. The premise of the old `do-ip6: no`
    # ("the LAN has no IPv6 RA") stopped being true when the RTX started
    # advertising the DHCPv6-PD delegated prefix.
    #
    # `::0` binds every v6 address, but that does NOT make this an open
    # resolver: unbound's access-control default is REFUSE for anything with no
    # matching netblock (man unbound.conf: "if none match refuse is used"), and
    # the implicit allows it inserts are localhost only. The `0.0.0.0/0 refuse`
    # line below is IPv4-shaped but no `::/0 refuse` is needed — the default
    # covers v6.
    #
    # The two families get SEPARATE sockets (unbound sets IPV6_V6ONLY on its
    # v6 listeners), so the v4 listener above keeps serving v4 clients from
    # real v4 source addresses rather than v4-mapped ones. Post-deploy assert:
    # `ss -lnu sport = :53` must show `[::]:53` and `0.0.0.0:53` as SEPARATE
    # lines — a single `*:53` would mean a shared dual-stack socket, and v4
    # ACL matching would already be broken at that point.
    interface: ::0@53
    port: 53
    do-ip4: yes
    do-ip6: yes
    do-udp: yes
    do-tcp: yes

    # NOTE: deliberately NO `interface-automatic` here. It was tried 2026-05-31
    # to fix the "active but zero replies on eth0" wedge and did NOT help — the
    # wedge recurred immediately after enabling it. The wedge is an intermittent
    # unbound startup condition, independent of this option (it also occurred
    # without it), and `interface-automatic` is flagged experimental + interacts
    # with so-reuseport. The off-box cookbooks/unbound-watchdog auto-restarts
    # unbound when the wedge occurs — that is the actual fix.

    # Access control: LAN + loopback only. Never an open resolver.
    #
    # Matching is longest-prefix and order-independent, and the default for an
    # unmatched source is refuse — so the v6 side needs no `::/0 refuse`
    # counterpart to the v4 line. (`::1/128` is now also inserted implicitly by
    # do-ip6; kept explicit because it costs nothing and documents intent.)
    #
    # The v6 allow is the ULA prefix ONLY. The LAN's globally-routable prefix
    # is DHCPv6-PD delegated and rotates, so allowing it would mean either a
    # literal that goes stale or a value derived at converge time — and a
    # derivation that ever degenerated to a shorter prefix would turn this box
    # into an open resolver on the public internet. The ULA is ours
    # permanently, so one static line covers every internal v6 client.
    #
    # Clients reach this resolver over v6 by its ULA address, and RFC 6724
    # source selection picks a ULA source for a ULA destination, so those
    # queries match the line below. LAN clients that learn the resolver over
    # DHCPv4 keep querying from a v4 source and match 192.168.1.0/24. Nothing
    # needs the GUA allowed.
    #
    # Note this is a reachability boundary, not a trust boundary: any on-link
    # device can self-assign an address inside a /64 it can hear RAs for. It
    # grants exactly what 192.168.1.0/24 grants — "you are on this LAN". The
    # real boundaries are the L2 segment and the RTX WAN filter
    # (home-monitor/rtx-hnd.tf, lan2 `in`, default reject).
    access-control: 0.0.0.0/0 refuse
    access-control: 127.0.0.0/8 allow
    access-control: ::1/128 allow
    access-control: 192.168.1.0/24 allow
    access-control: fd97:b085:767d::/64 allow

    # home.local / reverse are UNSIGNED internal zones reached via a forwarder;
    # tell the validator not to require a DNSSEC chain of trust for them.
    domain-insecure: "home.local."
    domain-insecure: "1.168.192.in-addr.arpa."

    # --- home.local served LOCALLY (VPC-independent), rendered from SSM ---
    # ALL home.local A records (home-monitor local.private_dns_forward, published
    # to SSM /host-registry/home-local-records) are served as local-data here, so
    # home.local resolution does NOT depend on the VPC Route53 forward path
    # (10.33.128.2 over the Tailscale subnet route). That forward path is
    # wedge-prone: a transient VPC outage pushes the forwarder RTO to the 120000ms
    # cap and unbound SERVFAILs home.local until restarted (observed 2026-05-31 /
    # 2026-06-02). Serving locally mirrors what the RTX rtx_dns_server "hosts"
    # block did (now retired) and also load-sheds the ELK fleet's burst lookups
    # off the ~90ms forward path. The block below is rendered at deploy time by
    # cookbooks/unbound/files/generate-home-local.sh from the SSM map; names NOT
    # in the registry still fall through to the forward-zone (Route53). If the SSM
    # fetch fails, the marker renders empty and home.local degrades to forward-only.
    #
    # AAAA comes from a SECOND parameter (/host-registry/home-local-records-v6)
    # and carries ULA addresses only, for the same reason the ACL above allows
    # only the ULA: the delegated global prefix rotates, so a published GUA
    # AAAA would point at an address the host no longer holds. Not every name
    # has one — Apple clients form RFC 7217 stable-privacy addresses rather
    # than EUI-64, so no stable value can be derived for them. A name with an A
    # but no AAAA answers NODATA for AAAA, which is the correct answer.
    # @@HOME_LOCAL_LOCAL_DATA@@

    # Search-domain doubling guard. Clients with a high ndots query the doubled
    # name <name>.home.local.home.local FIRST; those are always bogus but were
    # forwarded to 10.33.128.2 and SERVFAIL'd — the bulk of the original storm.
    # Answer NXDOMAIN locally so the client instantly falls through to the real
    # <name>.home.local.
    local-zone: "home.local.home.local." always_nxdomain

    # Watchdog canary. The off-box unbound-watchdog (PVE host timer,
    # cookbooks/unbound-watchdog) resolves this name via the LAN IP every 60s.
    # A timeout => unbound wedged/down; an empty/wrong answer => unbound is
    # running a stale config that predates this canary (deployed-but-not-reloaded,
    # the 2026-05-31 root cause). Either restarts unbound. TTL 0 so nothing caches
    # a stale positive; 192.0.2.1 is an RFC 5737 TEST-NET sentinel, never routed.
    #
    # The AAAA companion lets the watchdog prove the v6 listener separately —
    # unbound can be answering on v4 while its v6 socket is wedged, and an
    # A-only canary cannot tell those apart. 2001:db8::1 is the RFC 3849
    # documentation-range counterpart to the v4 sentinel, equally unroutable.
    # Adding it does not disturb the existing A probe: an A query still returns
    # exactly one record, so the watchdog's `dig +short ... A` comparison is
    # unchanged.
    local-zone: "unbound-watchdog.health." static
    local-data: "unbound-watchdog.health. 0 IN A 192.0.2.1"
    local-data: "unbound-watchdog.health. 0 IN AAAA 2001:db8::1"

    # DoT upstream certificate validation
    tls-cert-bundle: "/etc/ssl/certs/ca-certificates.crt"

    # Hardening / hygiene
    hide-identity: yes
    hide-version: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    qname-minimisation: yes
    prefetch: yes
    edns-buffer-size: 1232
    # CT118 has 2 cores. A single thread serialises the ~90ms home.local forwards
    # (10.33.128.2 over the Tailscale subnet route); under fleet query bursts the
    # requestlist backed up and LAN clients hit intermittent multi-second DNS
    # timeouts (2026-05-31). Two threads double forward concurrency so bursts are
    # absorbed instead of queued. Keep <= nproc to avoid oversubscription.
    num-threads: 2
    verbosity: 1
    use-syslog: yes

# Internal zones -> VPC Route53 Resolver (plain DNS over the LAN static route).
# home.local is also served from local-data above; this forward-zone is the
# fallback for any home.local name not in the SSM registry, plus reverse PTR.
forward-zone:
    name: "home.local."
    forward-addr: 10.33.128.2

forward-zone:
    name: "1.168.192.in-addr.arpa."
    forward-addr: 10.33.128.2

# Public -> DNS-over-TLS, two independent operators for availability.
# Cloudflare (1.1.1.1 / 1.0.0.1) + Quad9 (9.9.9.9 / 149.112.112.112). unbound
# prefers the fastest and fails over between them, so a single-operator outage
# (port 853 blocked, provider incident) degrades instead of hard-failing.
# DoT-only by design: there is intentionally NO plaintext fallback. Do NOT add
# forward-first: yes — with DoT-only forward-addr it would attempt a
# privacy-defeating plaintext retry with no plaintext target. Last-resort manual
# fallback if ALL DoT is unreachable: the RTX1210 stays up — temporarily repoint
# LAN DHCP DNS (or /etc/resolv.conf) to 1.1.1.1 until DoT recovers.
#
# The v6 addresses live in THIS zone block, not a second `forward-zone: "."`.
# forward-tls-upstream is per-zone, so a separate v6 zone would inherit nothing
# and silently forward in plaintext — the exact outcome the paragraph above
# forbids.
#
# Every entry carries `#<authname>`. Without it unbound accepts ANY name on the
# certificate as long as some CA in the bundle signed it (man unbound.conf:
# "If you leave out the '#' and auth name from the forward-addr, any name is
# accepted"), which reduces DoT to "encrypted to whoever holds any WebPKI cert"
# and hands an on-path attacker the whole public-DNS stream.
forward-zone:
    name: "."
    forward-tls-upstream: yes
    forward-addr: 1.1.1.1@853#cloudflare-dns.com
    forward-addr: 1.0.0.1@853#cloudflare-dns.com
    forward-addr: 2606:4700:4700::1111@853#cloudflare-dns.com
    forward-addr: 2606:4700:4700::1001@853#cloudflare-dns.com
    forward-addr: 2620:fe::fe@853#dns.quad9.net
    forward-addr: 2620:fe::9@853#dns.quad9.net
    forward-addr: 9.9.9.9@853#dns.quad9.net
    forward-addr: 149.112.112.112@853#dns.quad9.net
